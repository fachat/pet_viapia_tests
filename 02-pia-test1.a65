; ============================================================
; pia_test2.asm
; 6520 PIA Test Module 2 - PET-specific I/O tests
;
; Tests PIA behaviour using the I/O connections of the two
; 6520 PIAs present in the Commodore PET 4032:
;
;   PIA 1 ($E810-$E813) - Keyboard matrix interface
;     Test 1: DDR-A = $0F  (lower nibble are outputs)
;     Test 2: DDR-B = $00  (column sense lines are inputs)
;     Test 3: Keyboard scan - deassert all rows, Port-B
;             must read $FF when no key is pressed
;
; Each test saves the affected register state before the
; check and restores it afterwards.  Interrupts are disabled
; around register accesses to prevent KERNAL interference.
;
; IEEE-488 tests for PIA2 have been moved to Module 3
; (pia_test3.a65) where they are tested correctly.
;
; Target  : Commodore PET 4032
; Assembler: xa65  (command: xa)
; Load    : CBM BASIC LOAD then RUN  - or autostart in VICE
; ============================================================

; ============================================================
; Common hardware and zero-page definitions
; ============================================================
#include "hw.inc"

; ============================================================
; .PRG load address header
; ============================================================
* = $0401 - 2
        .word $0401         ; .prg load address (little-endian)

; ============================================================
; BASIC stub:  10 SYS 1037
; (identical header size to Module 1 - machine code at $040D)
; ============================================================
* = $0401
        .word basic_end     ; pointer to next BASIC line
        .word 10            ; BASIC line number
        .byte $9e           ; SYS token
        .byte "1037"        ; decimal address of code_start
        .byte 0             ; end of BASIC line
basic_end:
        .word 0             ; end of BASIC program

; ============================================================
; Machine code entry point  ($040D = 1037 decimal)
; ============================================================
* = $040D
main:
        lda #0
        sta PASS_CNT
        sta FAIL_CNT

        ; Clear screen
        lda #$93
        jsr CHROUT

        ; Print IOBASE address in hex on first line
        lda #<msg_iobase
        ldx #>msg_iobase
        jsr print_str
        lda #>IOBASE
        jsr print_hex
        lda #<IOBASE
        jsr print_hex
        lda #$0d
        jsr CHROUT

        ; Print banner
        lda #<msg_banner
        ldx #>msg_banner
        jsr print_str

        ; --------------------------------------------------------
        ; Test 1 - PIA1 DDR-A should equal $0F
        ;
        ; The PET KERNAL configures Port-A lower nibble as outputs
        ; to drive the keyboard row select lines, so DDR-A = $0F.
        ; Read DDR-A and verify it equals $0F.
        ; --------------------------------------------------------
        lda #<msg_t1
        ldx #>msg_t1
        jsr print_str

        sei
        lda PIA1_BASE+PIA_CRA   ; save CRA
        pha
        and #$FB                ; clear bit 2 -> select DDR access
        sta PIA1_BASE+PIA_CRA
        lda PIA1_BASE+PIA_ORA   ; read DDR-A into A
        tax                     ; stash in X
        pla                     ; A = original CRA
        sta PIA1_BASE+PIA_CRA   ; restore CRA
        cli
        txa                 ; DDR-A value back in A
        cmp #$0F
        beq t1_pass
        lda #1
        jmp t1_result
t1_pass:
        lda #0
t1_result:
        jsr print_result

        ; --------------------------------------------------------
        ; Test 2 - PIA1 DDR-B should equal $00
        ;
        ; The KERNAL configures Port-B as all inputs to read the
        ; keyboard column sense lines.
        ; --------------------------------------------------------
        lda #<msg_t2
        ldx #>msg_t2
        jsr print_str

        sei
        lda PIA1_BASE+PIA_CRB   ; save CRB
        pha
        and #$FB                ; clear bit 2 -> select DDR access
        sta PIA1_BASE+PIA_CRB
        lda PIA1_BASE+PIA_ORB   ; read DDR-B into A
        tax                     ; stash in X
        pla                     ; A = original CRB
        sta PIA1_BASE+PIA_CRB   ; restore CRB
        cli
        txa                 ; DDR-B value back in A
        cmp #$00
        beq t2_pass
        lda #1
        jmp t2_result
t2_pass:
        lda #0
t2_result:
        jsr print_result

        ; --------------------------------------------------------
        ; Test 3 - Keyboard scan: no key pressed -> Port-B = $FF
        ;
        ; Deassert all keyboard rows (set Port-A = $FF) then read
        ; the column sense lines.  With no key pressed every
        ; column line is pulled high, so Port-B must read $FF.
        ; --------------------------------------------------------
        lda #<msg_t3
        ldx #>msg_t3
        jsr print_str

        sei
        ; Save CRA, then enable data-register access (bit 2 = 1)
        lda PIA1_BASE+PIA_CRA
        pha                     ; stack: CRA
        ora #$04
        sta PIA1_BASE+PIA_CRA
        ; Save CRB, then enable data-register access
        lda PIA1_BASE+PIA_CRB
        pha                     ; stack: CRB, CRA
        ora #$04
        sta PIA1_BASE+PIA_CRB
        ; Save current Port-A output latch, then deassert all rows
        lda PIA1_BASE+PIA_ORA
        pha                     ; stack: Port-A, CRB, CRA
        lda #$FF
        sta PIA1_BASE+PIA_ORA   ; all rows deasserted (high = not selected)
        ; Read keyboard columns
        lda PIA1_BASE+PIA_ORB   ; column state -> A
        tax                     ; stash in X
        ; Restore Port-A, CRB, CRA in reverse push order
        pla                     ; A = orig Port-A
        sta PIA1_BASE+PIA_ORA
        pla                     ; A = orig CRB
        sta PIA1_BASE+PIA_CRB
        pla                     ; A = orig CRA
        sta PIA1_BASE+PIA_CRA
        cli
        txa                 ; column state back in A
        cmp #$FF
        beq t3_pass
        lda #1
        jmp t3_result
t3_pass:
        lda #0
t3_result:
        jsr print_result

        ; --------------------------------------------------------
        ; Summary
        ; --------------------------------------------------------
        lda #<msg_divider
        ldx #>msg_divider
        jsr print_str

        lda FAIL_CNT
        bne m2_some_fail

        lda #<msg_all_pass
        ldx #>msg_all_pass
        jsr print_str
        jmp m2_done

m2_some_fail:
        lda #<msg_some_fail
        ldx #>msg_some_fail
        jsr print_str

m2_done:
        rts                 ; return to BASIC

; ============================================================
; Subroutine: print_result
;
; Prints "OK" or "FAIL" (with CR) and updates counters.
; Input : A = 0 -> pass,  A != 0 -> fail
; ============================================================
print_result:
        cmp #0
        bne pr_fail

        inc PASS_CNT
        lda #<msg_ok
        ldx #>msg_ok
        jsr print_str
        rts

pr_fail:
        inc FAIL_CNT
        lda #<msg_fail
        ldx #>msg_fail
        jsr print_str
        rts

; ============================================================
; Subroutine: print_str
;
; Prints a null-terminated string via CHROUT.
; The string address is passed in A (low byte) and X (high
; byte); the routine stores them into STRPTR itself.
;
; Inputs:  A = low byte of string address
;          X = high byte of string address
; ============================================================
print_str:
        sta STRPTR          ; store low byte of address
        stx STRPTR+1        ; store high byte of address
ps_loop:
        ldy #0
        lda (STRPTR),y      ; fetch character
        beq ps_done
        jsr CHROUT
        inc STRPTR          ; advance pointer (low byte)
        bne ps_loop
        inc STRPTR+1        ; low byte wrapped: carry into high byte
        jmp ps_loop
ps_done:
        rts

; ============================================================
; Subroutine: print_hex
;
; Prints byte in A as two uppercase hex digits via CHROUT.
; Clobbers: A
; ============================================================
print_hex:
        pha
        lsr
        lsr
        lsr
        lsr
        jsr print_nybble
        pla
        and #$0f
        jsr print_nybble
        rts

print_nybble:
        cmp #10
        bcc ph_digit
        adc #6
ph_digit:
        adc #'0'
        jsr CHROUT
        rts

; ============================================================
; Messages (null-terminated, CBM uppercase charset)
; ============================================================
msg_iobase: .byte "IOBASE=$", 0
msg_banner:
        .byte "PIA TEST MODULE 2", $0d
        .byte "PET-SPECIFIC I/O", $0d
        .byte "(IEEE488 IN MOD3)", $0d
        .byte "----------------", $0d
        .byte 0

msg_t1: .byte "PIA1 DDRA=$0F:  ", 0
msg_t2: .byte "PIA1 DDRB=$00:  ", 0
msg_t3: .byte "KBD SCAN IDLE:  ", 0

msg_ok:         .byte "OK", $0d, 0
msg_fail:       .byte "FAIL", $0d, 0
msg_divider:    .byte "----------------", $0d, 0
msg_all_pass:   .byte "ALL TESTS PASSED", $0d, 0
msg_some_fail:  .byte "SOME TESTS FAILED", $0d, 0
