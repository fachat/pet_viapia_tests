; ============================================================
; Subroutine: test_t1_latch_rw
;
; Verifies that T1LL and T1LH latch registers are independently
; readable and writable without affecting each other.
;
; Saves original latch values, writes test patterns, reads back,
; then restores.  The counter is not disturbed (T1CH is not
; written).
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t1_latch_rw:
        sei

        ; save original latch values
        lda VIA_BASE+VIA_T1LL
        pha                         ; [stack: orig T1LL]
        lda VIA_BASE+VIA_T1LH
        pha                         ; [stack: orig T1LH, orig T1LL]

        ; test T1LL: write $55, read back
        lda #$55
        sta VIA_BASE+VIA_T1LL
        lda VIA_BASE+VIA_T1LL
        cmp #$55
        bne t1lrw_fail

        ; test T1LL: write $AA, read back
        lda #$AA
        sta VIA_BASE+VIA_T1LL
        lda VIA_BASE+VIA_T1LL
        cmp #$AA
        bne t1lrw_fail

        ; test T1LH: write $5A, read back
        lda #$5A
        sta VIA_BASE+VIA_T1LH       ; note: also clears IFR6
        lda VIA_BASE+VIA_T1LH
        cmp #$5A
        bne t1lrw_fail

        ; test T1LH: write $A5, read back
        lda #$A5
        sta VIA_BASE+VIA_T1LH
        lda VIA_BASE+VIA_T1LH
        cmp #$A5
        bne t1lrw_fail

        ; restore
        pla
        sta VIA_BASE+VIA_T1LH
        pla
        sta VIA_BASE+VIA_T1LL
        cli
        lda #0
        rts

t1lrw_fail:
        pla
        sta VIA_BASE+VIA_T1LH
        pla
        sta VIA_BASE+VIA_T1LL
        cli
        lda #1
        rts

; ============================================================
; Subroutine: test_t1_latch_no_start
;
; Verifies that writing T1LL and T1LH does not start or reset
; the T1 counter.  If the counter were disturbed, IFR6 would
; change unexpectedly.
;
; Strategy:
;   1. Start T1 with a large value ($FFFF) so it won't expire.
;   2. Clear IFR6 by reading T1CL.
;   3. Write T1LL and T1LH latch registers.
;   4. Read T1CL twice to verify the counter is still moving
;      (i.e. it was not restarted: if it were restarted from
;      $FFFF the two reads would differ by 14 from ~$FFFE,
;      whereas from the already-running timer they differ by
;      the same 14 but from a lower value -- the important
;      check is simply that T1CH was NOT written and IFR6
;      was NOT set mid-test).
;   5. Verify IFR6 is still clear (no spurious timeout).
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t1_latch_no_start:
        sei

        ; start T1 with $FFFF in single-shot mode (should already be set)
        lda #$FF
        sta VIA_BASE+VIA_T1LL
        lda #$FF
        sta VIA_BASE+VIA_T1LH       ; clears IFR6
        lda #$FF
        sta VIA_BASE+VIA_T1CH       ; starts timer from $FFFF
        lda VIA_BASE+VIA_T1CL       ; clear IFR6 from the start
        ; now write only latch registers (must not restart counter)
        lda #$12
        sta VIA_BASE+VIA_T1LL
        lda #$34
        sta VIA_BASE+VIA_T1LH       ; clears IFR6
        ; read counter; it must still be running (well below $FFFF)
        lda VIA_BASE+VIA_T1CL       ; this also clears IFR6
        sta TMP                     ; save current T1CL reading
        ; IFR6 must still be clear: no timeout fired while writing latches
        lda VIA_BASE+VIA_IFR
        and #IFR_T1
        bne t1lns_fail              ; IFR6 set = spurious timeout
        ; counter must be less than $FF (well into the run for $FFFF)
        ; but since we started from $FFFF and had some overhead,
        ; it should be < $F0.  A simple sanity: counter < $F0.
        lda TMP
        cmp #$F0
        bcs t1lns_fail              ; >= $F0 means counter barely moved = bad
        ; latch must still be $12 (not overwritten by counter)
        lda VIA_BASE+VIA_T1LL
        cmp #$12
        bne t1lns_fail

        cli
        lda #0
        rts
t1lns_fail:
        cli
        lda #1
        rts

; ============================================================
; Subroutine: test_t1lh_clears_ifr
;
; Verifies that writing T1LH clears IFR bit 6 (T1 timeout flag)
; even without reading T1CL or writing T1CH.
;
; Strategy:
;   1. Force-set IFR6 by starting T1 with latch=0 and waiting.
;   2. Confirm IFR6 is set.
;   3. Write T1LH.
;   4. Verify IFR6 is now clear.
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t1lh_clears_ifr:
        sei

        ; load T1 with $0000 so it times out almost immediately
        lda #$00
        sta VIA_BASE+VIA_T1LL
        lda #$00
        sta VIA_BASE+VIA_T1LH       ; clears IFR6
        sta VIA_BASE+VIA_T1CH       ; starts T1 with $0000

        ; wait a few cycles for the timeout to fire
        nop
        nop
        nop
        nop

        ; IFR6 should now be set
        lda VIA_BASE+VIA_IFR
        and #IFR_T1
        beq t1lcifr_fail2           ; not set = unexpected (step 2)

        ; writing T1LH should clear IFR6
        lda #$00
        sta VIA_BASE+VIA_T1LH

        ; IFR6 must now be clear
        lda VIA_BASE+VIA_IFR
        and #IFR_T1
        bne t1lcifr_fail4           ; still set = fail (step 4)

        cli
        lda #0
        rts
t1lcifr_fail2:
        cli
        lda #2
        sta FAIL_IDX
        lda #1
        rts
t1lcifr_fail4:
        cli
        lda #4
        sta FAIL_IDX
        lda #1
        rts

; ============================================================
; Subroutine: test_ifr_write_clears_t1
;
; Verifies that writing IFR_T1 (bit 6) directly to the IFR
; register clears IFR bit 6 (T1 timeout flag).
;
; Strategy:
;   1. Force-set IFR6 by starting T1 with latch=0 and waiting.
;   2. Confirm IFR6 is set.
;   3. Write IFR_T1 to IFR (direct clear).
;   4. Verify IFR6 is now clear.
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_ifr_write_clears_t1:
        sei

        ; load T1 with $0000 so it times out almost immediately
        lda #$00
        sta VIA_BASE+VIA_T1LL
        lda #$00
        sta VIA_BASE+VIA_T1LH       ; clears IFR6
        sta VIA_BASE+VIA_T1CH       ; starts T1 with $0000

        ; wait a few cycles for the timeout to fire
        nop
        nop
        nop
        nop

        ; IFR6 should now be set
        lda VIA_BASE+VIA_IFR
        and #IFR_T1
        beq ifr_wct1_fail2          ; not set = unexpected (step 2)

        ; writing IFR_T1 to IFR should clear IFR6
        lda #IFR_T1
        sta VIA_BASE+VIA_IFR

        ; IFR6 must now be clear
        lda VIA_BASE+VIA_IFR
        and #IFR_T1
        bne ifr_wct1_fail4          ; still set = fail (step 4)

        cli
        lda #0
        rts
ifr_wct1_fail2:
        cli
        lda #2
        sta FAIL_IDX
        lda #1
        rts
ifr_wct1_fail4:
        cli
        lda #4
        sta FAIL_IDX
        lda #1
        rts

; ============================================================
; Subroutine: test_t1ch_starts
;
; Verifies that writing T1CH:
;   (a) loads T1CL from T1LL (not directly from the byte written),
;   (b) starts the counter decrementing.
;
; Strategy:
;   1. Write $AA to T1LL (latch low), $00 to T1LH.
;   2. Write $00 to T1CH.
;   3. Read T1CL twice, a few cycles apart.
;   4. First read must equal $AA minus a small offset (confirms
;      T1CL was loaded from T1LL, not from the $00 in T1CH).
;   5. Second read must be less than first read (counter moving).
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t1ch_starts:
        sei
        lda #$AA
        sta VIA_BASE+VIA_T1LL
        lda #$00
        sta VIA_BASE+VIA_T1LH
        sta VIA_BASE+VIA_T1CH       ; starts T1; T1CL loaded from T1LL ($AA)
        lda VIA_BASE+VIA_T1CL       ; first read: should be ~$AA - offset
        sta TMP                     ; save first reading
        nop
        nop
        lda VIA_BASE+VIA_T1CL       ; second read: should be less than first
        ; check (a): first reading must be <= $AA (loaded from latch, not $00)
        ;            and > $80 (close to $AA, not close to $00)
        lda TMP
        cmp #$80
        bcc t1chs_fail              ; < $80 means loaded from wrong value
        ; check (b): second read must be < first read (counter decrementing)
        lda VIA_BASE+VIA_T1CL
        cmp TMP
        bcs t1chs_fail              ; >= first = counter not moving

        cli
        lda #0
        rts
t1chs_fail:
        cli
        lda #1
        rts

; ============================================================
; Subroutine: test_t1ch_starts_ifr
;
; Verifies that writing T1CH starts T1 and that IFR.T1 (bit 6)
; is set when the T1 counter underflows.
;
; Strategy:
;   1. Write $00 to T1LL and T1LH (latch=$0000).
;   2. Write $00 to T1CH to load the latch into the counter
;      and start T1.  With latch=$0000 the counter reaches
;      $FFFF on the very next cycle and underflows almost
;      immediately.
;   3. Wait a few cycles for the underflow to occur.
;   4. Read IFR and check that IFR.T1 (bit 6) is set.
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t1ch_starts_ifr:
        sei
        lda #$00
        sta VIA_BASE+VIA_T1LL
        lda #$00
        sta VIA_BASE+VIA_T1LH       ; clears IFR6
        sta VIA_BASE+VIA_T1CH       ; starts T1 with $0000

        ; wait a few cycles for the timer to underflow
        nop
        nop
        nop
        nop

        ; IFR.T1 (bit 6) must now be set
        lda VIA_BASE+VIA_IFR
        and #IFR_T1
        beq t1csifr_fail            ; not set = timer did not underflow

        cli
        lda #0
        rts
t1csifr_fail:
        cli
        lda #1
        rts

; ============================================================
; Subroutine: test_t2_latch_no_start
;
; Verifies that writing T2CL (latch) does not start the timer.
; Writing T2CH must be the action that starts counting.
;
; Strategy:
;   1. Clear IFR5 by reading T2CL.
;   2. Write a value to T2CL (latch only, no start).
;   3. IFR5 must be clear immediately (timer not started).
;   4. Wait several cycles.
;   5. IFR5 must still be clear (timer did not start).
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t2_latch_no_start:
        sei

        ; clear IFR5
        lda VIA_BASE+VIA_T2CL

        ; write only the latch (must not start timer)
        lda #$01
        sta VIA_BASE+VIA_T2CL

        ; IFR5 must be clear immediately after writing latch (step 3)
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        bne t2lns_fail3

        ; wait - if the timer had started with latch=1 it would
        ; expire within ~2 cycles and set IFR5
        nop
        nop
        nop
        nop
        nop
        nop

        ; IFR5 must still be clear (step 5)
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        bne t2lns_fail5

        cli
        lda #0
        rts
t2lns_fail3:
        cli
        lda #3
        sta FAIL_IDX
        lda #1
        rts
t2lns_fail5:
        cli
        lda #5
        sta FAIL_IDX
        lda #1
        rts

; ============================================================
; Subroutine: test_t2ch_starts
;
; Verifies that writing T2CH starts the T2 timer, loading the
; counter low byte from the T2CL latch.
;
; Strategy:
;   1. Clear IFR5 by writing IFR_T2 to VIA_IFR.
;   2. Verify IFR5 is clear.
;   3. Write $14 to T2CL (latch).
;   4. Write $00 to T2CH (starts timer, counter = $0014).
;   5. IFR5 must be clear immediately (timer not yet expired).
;   6. Wait for IFR5 to be set (timer expired).
;   7. If IFR5 is set within a reasonable timeout, test passes.
;   8. Clear IFR5 by writing IFR_T2 to VIA_IFR; verify it is clear.
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t2ch_starts:
        sei

        ; clear IFR5 by writing IFR_T2 to VIA_IFR (step 1)
        lda #IFR_T2
        sta VIA_BASE+VIA_IFR

        ; verify IFR5 is clear (step 2)
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        bne t2chs_fail2

        ; load T2 with $0014 and start (steps 3-4)
        lda #$14
        sta VIA_BASE+VIA_T2CL
        lda #$00
        sta VIA_BASE+VIA_T2CH       ; starts timer

        ; IFR5 must be clear immediately after starting (step 5)
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        bne t2chs_fail5             ; set = timer expired too soon

        ; wait for IFR5 (T2 should expire after ~$14+overhead cycles)
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop

        ; IFR5 must be set (timer fired, step 7)
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        beq t2chs_fail7             ; IFR5 not set = timer did not fire

        ; clear IFR5 by writing IFR_T2 to VIA_IFR (step 8)
        lda #IFR_T2
        sta VIA_BASE+VIA_IFR

        ; verify IFR5 is clear (step 8)
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        bne t2chs_fail8

        cli
        lda #0
        rts
t2chs_fail2:
        cli
        lda #2
        sta FAIL_IDX
        lda #1
        rts
t2chs_fail5:
        cli
        lda #5
        sta FAIL_IDX
        lda #1
        rts
t2chs_fail7:
        cli
        lda #7
        sta FAIL_IDX
        lda #1
        rts
t2chs_fail8:
        cli
        lda #8
        sta FAIL_IDX
        lda #1
        rts

; ============================================================
; Subroutine: test_t2ch_starts2
;
; Duplicate of test_t2ch_starts.  Also clears IFR5 via a write
; to VIA_IFR and verifies the bit is clear after each clear.
;
; Strategy:
;   1. Clear IFR5 by writing IFR_T2 to VIA_IFR.
;   2. Verify IFR5 is clear.
;   3. Write $14 to T2CL (latch).
;   4. Write $00 to T2CH (starts timer, counter = $0014).
;   5. IFR5 must be clear immediately (timer not yet expired).
;   6. Wait for IFR5 to be set (timer expired).
;   7. If IFR5 is set within a reasonable timeout, test passes.
;   8. Clear IFR5 by writing IFR_T2 to VIA_IFR; verify it is clear.
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t2ch_starts2:
        sei

        ; clear IFR5 by writing IFR_T2 to VIA_IFR (step 1)
        lda #IFR_T2
        sta VIA_BASE+VIA_IFR

        ; verify IFR5 is clear (step 2)
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        bne t2chs2_fail2

        ; load T2 with $0014 and start (steps 3-4)
        lda #$14
        sta VIA_BASE+VIA_T2CL
        lda #$00
        sta VIA_BASE+VIA_T2CH       ; starts timer

        ; IFR5 must be clear immediately after starting (step 5)
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        bne t2chs2_fail5            ; set = timer expired too soon

        ; wait for IFR5 (T2 should expire after ~$14+overhead cycles)
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop

        ; IFR5 must be set (timer fired, step 7)
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        beq t2chs2_fail7            ; IFR5 not set = timer did not fire

        ; clear IFR5 by writing IFR_T2 to VIA_IFR (step 8)
        lda #IFR_T2
        sta VIA_BASE+VIA_IFR

        ; verify IFR5 is clear (step 8)
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        bne t2chs2_fail8

        cli
        lda #0
        rts
t2chs2_fail2:
        cli
        lda #2
        sta FAIL_IDX
        lda #1
        rts
t2chs2_fail5:
        cli
        lda #5
        sta FAIL_IDX
        lda #1
        rts
t2chs2_fail7:
        cli
        lda #7
        sta FAIL_IDX
        lda #1
        rts
t2chs2_fail8:
        cli
        lda #8
        sta FAIL_IDX
        lda #1
        rts

; ============================================================
; Subroutine: test_t2_pb6_count_high
;
; Verifies T2 pulse-count mode using the PET IEEE-488 NRFD
; loopback from VIA PB1 (/NRFD out) to VIA PB6 (/NRFD in),
; with PB6 starting high before T2 is armed.
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t2_pb6_count_high:
        lda #0
        sta T2_MODE
        jmp test_t2_pb6_count_common

; ============================================================
; Subroutine: test_t2_pb6_count_low
;
; Same as test_t2_pb6_count_high, but PB6 starts low before T2
; is armed, so the first write of 0 must not decrement T2.
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t2_pb6_count_low:
        lda #1
        sta T2_MODE

; ============================================================
; Subroutine: test_t2_pb6_count_common
;
; Common implementation for the PB6 pulse-counting tests.
; T2_MODE = 0 -> start PB6 high
; T2_MODE = 1 -> start PB6 low
;
; Sequence:
;   1. Save ACR/DDRB/ORB and configure PB1 as the driven output.
;   2. Force PB6 high or low through the PB1->PB6 NRFD loopback.
;   3. Enable T2 pulse-count mode (ACR bit 5 = 1).
;   4. Load T2 = $0005 by writing T2CL then T2CH.
;   5. Toggle PB1 low/high and verify only the low transitions
;      decrement T2.
;   6. Verify IFR.T2 sets on the underflowing low transition.
;   7. Keep toggling and verify T2 continues counting after
;      underflow.
;
; Returns: A=0 pass, A=1 fail
; ============================================================
test_t2_pb6_count_common:
        sei

        lda VIA_BASE+VIA_ACR
        sta T2_ACR
        lda VIA_BASE+VIA_DDRB
        sta T2_DDRB
        lda VIA_BASE+VIA_ORB
        sta ORB_SAVE

        ora #VIA_NRFD_OUT
        sta ORB_HIGH

        lda T2_DDRB
        ora #VIA_NRFD_OUT
        sta VIA_BASE+VIA_DDRB
        lda ORB_HIGH
        sta VIA_BASE+VIA_ORB

        lda T2_MODE
        beq t2pb6_init_high

        lda ORB_HIGH
        eor #VIA_NRFD_OUT
        sta VIA_BASE+VIA_ORB
        lda VIA_BASE+VIA_ORB
        and #VIA_NRFD_IN
        beq t2pb6_init_low_ok
        jmp t2pb6_fail01
t2pb6_init_low_ok:
        jmp t2pb6_init_done

t2pb6_init_high:
        lda VIA_BASE+VIA_ORB
        and #VIA_NRFD_IN
        cmp #VIA_NRFD_IN
        beq t2pb6_init_done
        jmp t2pb6_fail01

t2pb6_init_done:
        lda VIA_BASE+VIA_ACR
        ora #ACR_T2_MASK
        sta VIA_BASE+VIA_ACR

        lda #$05
        sta VIA_BASE+VIA_T2CL
        lda #$00
        sta VIA_BASE+VIA_T2CH

        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        beq t2pb6_ifr_ok
        jmp t2pb6_fail02
t2pb6_ifr_ok:

        lda T2_MODE
        beq t2pb6_run_main

        lda ORB_HIGH
        eor #VIA_NRFD_OUT
        sta VIA_BASE+VIA_ORB
        lda VIA_BASE+VIA_T2CL
        cmp #$05
        beq t2pb6_first_low_ok
        jmp t2pb6_fail05
t2pb6_first_low_ok:

        lda ORB_HIGH
        sta VIA_BASE+VIA_ORB
        lda VIA_BASE+VIA_T2CL
        cmp #$05
        beq t2pb6_run_main
        jmp t2pb6_fail85

t2pb6_run_main:
        lda #$05
        sta T2_LAST
        ldx #5

t2pb6_main_lp:
        dec T2_LAST
        lda ORB_HIGH
        eor #VIA_NRFD_OUT
        sta VIA_BASE+VIA_ORB
        lda VIA_BASE+VIA_T2CL
        cmp T2_LAST
        bne t2pb6_fail_lo

        lda ORB_HIGH
        sta VIA_BASE+VIA_ORB
        lda VIA_BASE+VIA_T2CL
        cmp T2_LAST
        bne t2pb6_fail_hi

        dex
        bne t2pb6_main_lp

        lda ORB_HIGH
        eor #VIA_NRFD_OUT
        sta VIA_BASE+VIA_ORB
        lda VIA_BASE+VIA_IFR
        and #IFR_T2
        beq t2pb6_fail_ifr

        lda VIA_BASE+VIA_T2CL
        cmp #$ff
        beq t2pb6_got_ff
        jmp t2pb6_fail_ff
t2pb6_got_ff:
        sta T2_LAST

        lda ORB_HIGH
        sta VIA_BASE+VIA_ORB
        lda VIA_BASE+VIA_T2CL
        cmp T2_LAST
        beq t2pb6_post_setup_ok
        jmp t2pb6_fail7f
t2pb6_post_setup_ok:

        ldx #5
t2pb6_post_lp:
        dec T2_LAST
        lda ORB_HIGH
        eor #VIA_NRFD_OUT
        sta VIA_BASE+VIA_ORB
        lda VIA_BASE+VIA_T2CL
        cmp T2_LAST
        bne t2pb6_fail_lo

        lda ORB_HIGH
        sta VIA_BASE+VIA_ORB
        lda VIA_BASE+VIA_T2CL
        cmp T2_LAST
        bne t2pb6_fail_hi

        dex
        bne t2pb6_post_lp

        lda #0
        jmp t2pb6_restore

t2pb6_fail_lo:
        lda T2_LAST
        sta FAIL_IDX
        lda #1
        jmp t2pb6_restore

t2pb6_fail_hi:
        lda T2_LAST
        ora #$80
        sta FAIL_IDX
        lda #1
        jmp t2pb6_restore

t2pb6_fail_ifr:
        lda T2_MODE
        beq t2pb6_fail06
        lda #$07
        bne t2pb6_fail_set
t2pb6_fail06:
        lda #$06
t2pb6_fail_set:
        sta FAIL_IDX
        lda #1
        jmp t2pb6_restore

t2pb6_fail01:
        lda #$01
        sta FAIL_IDX
        lda #1
        jmp t2pb6_restore

t2pb6_fail02:
        lda #$02
        sta FAIL_IDX
        lda #1
        jmp t2pb6_restore

t2pb6_fail05:
        lda #$05
        sta FAIL_IDX
        lda #1
        jmp t2pb6_restore

t2pb6_fail85:
        lda #$85
        sta FAIL_IDX
        lda #1
        jmp t2pb6_restore

t2pb6_fail_ff:
        lda #$ff
        sta FAIL_IDX
        lda #1
        jmp t2pb6_restore

t2pb6_fail7f:
        lda #$7f
        sta FAIL_IDX
        lda #1
        jmp t2pb6_restore

t2pb6_restore:
        sta TMP
        lda #IFR_T2
        sta VIA_BASE+VIA_IFR
        lda T2_ACR
        sta VIA_BASE+VIA_ACR
        lda T2_DDRB
        sta VIA_BASE+VIA_DDRB
        lda ORB_SAVE
        sta VIA_BASE+VIA_ORB
        cli
        lda TMP
        rts
