; Message strings (null-terminated, CBM uppercase charset)
; ============================================================
msg_iobase:   .byte "IOBASE=$", 0
msg_banner:   .byte "VIA TEST MODULE 1", $0d
              .byte "-----------------", $0d, 0

msg_grp1:     .byte "GRP1: T1 LATCH/COUNTER REGS", $0d, 0
msg_t1a:      .byte "  1A T1LL/T1LH RD/WR: ", 0
msg_t1b:      .byte "  1B T1LL/T1LH NO-START: ", 0
msg_t1c:      .byte "  1C T1LH CLEARS IFR6: ", 0
msg_t1d:      .byte "  1D T1CH LOADS+STARTS: ", 0
msg_t1e:      .byte "  1E IFR WRITE CLEARS IFR6: ", 0

msg_grp2:     .byte "GRP2: T2 LATCH/COUNTER REGS", $0d, 0
