; ============================================================
; 08-sr-test-gen.a65
; VIA Shift Register Test - Reference Data Generator
;
; Runs the SR measurement loops used by 08-sr-test.a65
; and saves the raw results (256 bytes each) to CBM sequential
; files on device 8 (IEEE-488 disk drive).  Run this once on a
; known-good machine or in the VICE emulator to produce the
; reference data that 08-sr-test.a65 will compare against.
;
; In SR mode 1 (shift in under T2 control):
;   - CB2 is the data input (held high via PA7 loopback).
;   - The VIA drives CB1 as the output shift clock.
;   - T2 underflows generate the CB1 clock; after 8 bits the
;     IFR.SR bit is set.
;   - PIA1 PA7 MUST be an input to avoid bus conflict on CB1.
;
; Files written (CBM PRG, 256 bytes + 2-byte load address header):
;   V.SR.M1G2.A     SR mode 1, T2 initial value = $0110
;   V.SR.M1G2.B     SR mode 1, T2 initial value = $0220
;   V.SR.M1G2.C     SR mode 1, T2 initial value = $0330
;   V.SR.M1G2.D     SR mode 1, T2 initial value = $0440
;   V.SR.M1NG3.A    SR mode 1 no-arm, T2 initial value = $0110
;   V.SR.M1NG3.B    SR mode 1 no-arm, T2 initial value = $0220
;   V.SR.M1NG3.C    SR mode 1 no-arm, T2 initial value = $0330
;   V.SR.M1NG3.D    SR mode 1 no-arm, T2 initial value = $0440
;   V.SR.IT2G16.A.H SR shift-in via T2, T2 pre-set ($04FF then $0210), T2CH samples
;   V.SR.IT2G16.A.L SR shift-in via T2, T2 pre-set ($04FF then $0210), T2CL samples
;   V.SR.IT2G16.B.H SR shift-in via T2, T2=$0210 direct, T2CH samples
;   V.SR.IT2G16.B.L SR shift-in via T2, T2=$0210 direct, T2CL samples
;   V.SR.IT2G16.C.H SR shift-in via T2, T2=$0210+16cy wait+latch=$20, T2CH samples
;   V.SR.IT2G16.C.L SR shift-in via T2, T2=$0210+16cy wait+latch=$20, T2CL samples
;   V.SR.M4G12.55.A SR mode 4, SR=$55, T2 initial value = $0110
;   V.SR.M4G12.55.B SR mode 4, SR=$55, T2 initial value = $0220
;   V.SR.M4G12.55.C SR mode 4, SR=$55, T2 initial value = $0330
;   V.SR.M4G12.55.D SR mode 4, SR=$55, T2 initial value = $0440
;   V.SR.M4G13.AA.A SR mode 4, SR=$AA, T2 initial value = $0110
;   V.SR.M4G13.AA.B SR mode 4, SR=$AA, T2 initial value = $0220
;   V.SR.M4G13.AA.C SR mode 4, SR=$AA, T2 initial value = $0330
;   V.SR.M4G13.AA.D SR mode 4, SR=$AA, T2 initial value = $0440
;   V.SR.M5G7.55.A  SR mode 5, SR=$55, T2 initial value = $0110
;   V.SR.M5G7.55.B  SR mode 5, SR=$55, T2 initial value = $0220
;   V.SR.M5G7.55.C  SR mode 5, SR=$55, T2 initial value = $0330
;   V.SR.M5G7.55.D  SR mode 5, SR=$55, T2 initial value = $0440
;   V.SR.M5G8.AA.A  SR mode 5, SR=$AA, T2 initial value = $0110
;   V.SR.M5G8.AA.B  SR mode 5, SR=$AA, T2 initial value = $0220
;   V.SR.M5G8.AA.C  SR mode 5, SR=$AA, T2 initial value = $0330
;   V.SR.M5G8.AA.D  SR mode 5, SR=$AA, T2 initial value = $0440
;
; Files are written using PET_SAVE (JMP $f6e3), bypassing the
; $FFD8 KERNAL entry which includes BASIC parsing.
;
; Target   : Commodore PET 4032
; Assembler: xa65  (command: xa -W -XMASM)
; Load     : LOAD then RUN  -- or autostart in VICE
; ============================================================

; ============================================================
; Common hardware and zero-page definitions
; ============================================================
#include "hw.inc"

; ============================================================
; Zero-page ($09-$12 - file-specific)
; ============================================================
ACR_SAVE  = $09             ; saved VIA ACR value
IER_SAVE  = $0A             ; saved VIA IER value
MEAS_ACR  = $0B             ; current measurement ACR, saved/restored around KERNAL calls
SAVE_START = $0C            ; 2-byte ZP buffer ($0C-$0D) for start address passed to PET_SAVE
SR_T2_LO  = $0E             ; T2 initial value low byte (written before calling meas_sr_mode1)
SR_T2_HI  = $0F             ; T2 initial value high byte
SR_INIT   = $10             ; initial value written to SR in meas_sr_mode4 / meas_sr_mode5 before sampling
SR_IFR_PRE  = $11           ; IFR & IFR_SR sampled before arming SR (expected: 0)
SR_IFR_POST = $12           ; IFR & IFR_SR sampled after sample loop (expected: IFR_SR)

; ============================================================
; Memory buffers
; ============================================================
MEAS_BUF = $7F00            ; measurement result buffer (256 bytes, $7F00-$7FFF)
; NOTE: MEAS_BUF must equal REF_BUF in 08-sr-test.a65 ($7F00) so that
; the PRG file header embeds the correct load address and 08-sr-test.a65
; can load it without an address override (SA=0).

; ============================================================
; .PRG file header
; ============================================================
* = $0401 - 2
        .word $0401         ; .prg load address (little-endian)

* = $0401
        .word basic_end     ; pointer to next BASIC line
        .word 10            ; BASIC line number
        .byte $9e           ; SYS token
        .byte "1037"        ; decimal address of code_start
        .byte 0             ; end of BASIC line
basic_end:
        .word 0             ; end of BASIC program

; ============================================================
; Machine code entry point  ($040D = 1037 decimal)
;
; SYS 1037 executes the 3-byte JMP at $040D, which jumps over
; the included measurement subroutines to main.  Placing the
; measurement code at $0410 (immediately after the JMP, and at
; the same address in via_sr_test.prg) guarantees identical
; branch-target page alignment and thus cycle-accurate timing
; reproducibility between the generator and test runs.
; ============================================================
* = $040D
        jmp main            ; skip measurement code; land at main below

.include "08-meas.i65"   ; meas_sr_mode1 subroutine assembled at $0410

; ============================================================
; Main entry point
; ============================================================
main:
        lda #0
        sta PASS_CNT
        sta FAIL_CNT

        ; clear screen
        lda #$93
        jsr CHROUT

        lda #<msg_banner
        ldx #>msg_banner
        jsr print_str

        ; save VIA state and disable T1/T2/SR interrupts
        sei
        lda VIA_BASE+VIA_ACR
        sta ACR_SAVE
        lda VIA_BASE+VIA_IER
        sta IER_SAVE
        lda #IFR_T1|IFR_T2|IFR_SR  ; bit7=0: disable these IRQ sources
        sta VIA_BASE+VIA_IER
        cli

        ; Ensure PIA1 PA7 is an input so VIA can drive CB1 freely in mode 1
        ; (CB1 is the VIA output clock in SR shift-in mode; PIA1 PA7 being an
        ;  output would cause a bus conflict on the CB1 line.)
        sei
        lda PIA1_BASE+PIA_CRA
        pha                         ; save CRA
        and #$FB                    ; select DDRA (bit 2 = 0)
        sta PIA1_BASE+PIA_CRA
        lda PIA1_BASE+PIA_ORA       ; read DDRA
        and #$7F                    ; clear PA7 bit -> PA7 = input
        sta PIA1_BASE+PIA_ORA
        pla
        sta PIA1_BASE+PIA_CRA       ; restore CRA
        cli

        ; --------------------------------------------------------
        ; SR mode 1, T2 initial value = $0110
        ; --------------------------------------------------------
        lda #<msg_sr_m1
        ldx #>msg_sr_m1
        jsr print_str

        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode1
        lda #fn_sr_m1a_end - fn_sr_m1a
        ldx #<fn_sr_m1a
        ldy #>fn_sr_m1a
        jsr write_file

        ; --------------------------------------------------------
        ; SR mode 1, T2 initial value = $0220
        ; --------------------------------------------------------
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode1
        lda #fn_sr_m1b_end - fn_sr_m1b
        ldx #<fn_sr_m1b
        ldy #>fn_sr_m1b
        jsr write_file

        ; --------------------------------------------------------
        ; SR mode 1, T2 initial value = $0330
        ; --------------------------------------------------------
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode1
        lda #fn_sr_m1c_end - fn_sr_m1c
        ldx #<fn_sr_m1c
        ldy #>fn_sr_m1c
        jsr write_file

        ; --------------------------------------------------------
        ; SR mode 1, T2 initial value = $0440
        ; --------------------------------------------------------
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode1
        lda #fn_sr_m1d_end - fn_sr_m1d
        ldx #<fn_sr_m1d
        ldy #>fn_sr_m1d
        jsr write_file
        lda #<msg_nl
        ldx #>msg_nl
        jsr print_str

        ; --------------------------------------------------------
        ; SR mode 1 (no arm read), T2 initial value = $0110-$0440
        ; In this variant the arm read is omitted; shifting begins
        ; on the first T2 underflow after setting ACR to mode 1.
        ; --------------------------------------------------------
        lda #<msg_sr_m1n
        ldx #>msg_sr_m1n
        jsr print_str

        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        lda #fn_sr_m1na_end - fn_sr_m1na
        ldx #<fn_sr_m1na
        ldy #>fn_sr_m1na
        jsr write_file

        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        lda #fn_sr_m1nb_end - fn_sr_m1nb
        ldx #<fn_sr_m1nb
        ldy #>fn_sr_m1nb
        jsr write_file

        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        lda #fn_sr_m1nc_end - fn_sr_m1nc
        ldx #<fn_sr_m1nc
        ldy #>fn_sr_m1nc
        jsr write_file

        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        lda #fn_sr_m1nd_end - fn_sr_m1nd
        ldx #<fn_sr_m1nd
        ldy #>fn_sr_m1nd
        jsr write_file
        lda #<msg_nl
        ldx #>msg_nl
        jsr print_str

        ; --------------------------------------------------------
        ; SR mode 4 (shift out under free-running T2 control), SR init = $55
        ; PIA1 PA7 and VIA PA7 are both inputs (already set above).
        ; meas_sr_mode4 sets VIA DDRA=$00 internally.
        ; --------------------------------------------------------
        lda #<msg_sr_m45
        ldx #>msg_sr_m45
        jsr print_str

        lda #$55
        sta SR_INIT
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode4
        lda #fn_sr_m4a_end - fn_sr_m4a
        ldx #<fn_sr_m4a
        ldy #>fn_sr_m4a
        jsr write_file

        lda #$55
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode4
        lda #fn_sr_m4b_end - fn_sr_m4b
        ldx #<fn_sr_m4b
        ldy #>fn_sr_m4b
        jsr write_file

        lda #$55
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode4
        lda #fn_sr_m4c_end - fn_sr_m4c
        ldx #<fn_sr_m4c
        ldy #>fn_sr_m4c
        jsr write_file

        lda #$55
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode4
        lda #fn_sr_m4d_end - fn_sr_m4d
        ldx #<fn_sr_m4d
        ldy #>fn_sr_m4d
        jsr write_file
        lda #<msg_nl
        ldx #>msg_nl
        jsr print_str

        ; --------------------------------------------------------
        ; SR mode 4 (shift out under free-running T2 control), SR init = $AA
        ; --------------------------------------------------------
        lda #<msg_sr_m4aa
        ldx #>msg_sr_m4aa
        jsr print_str

        lda #$aa
        sta SR_INIT
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode4
        lda #fn_sr_m4aaa_end - fn_sr_m4aaa
        ldx #<fn_sr_m4aaa
        ldy #>fn_sr_m4aaa
        jsr write_file

        lda #$aa
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode4
        lda #fn_sr_m4aab_end - fn_sr_m4aab
        ldx #<fn_sr_m4aab
        ldy #>fn_sr_m4aab
        jsr write_file

        lda #$aa
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode4
        lda #fn_sr_m4aac_end - fn_sr_m4aac
        ldx #<fn_sr_m4aac
        ldy #>fn_sr_m4aac
        jsr write_file

        lda #$aa
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode4
        lda #fn_sr_m4aad_end - fn_sr_m4aad
        ldx #<fn_sr_m4aad
        ldy #>fn_sr_m4aad
        jsr write_file
        lda #<msg_nl
        ldx #>msg_nl
        jsr print_str

        ; --------------------------------------------------------
        ; SR mode 5 (shift out under T2 control), SR init = $55
        ; PIA1 PA7 and VIA PA7 are both inputs (already set above).
        ; meas_sr_mode5 sets VIA DDRA=$00 internally.
        ; --------------------------------------------------------
        lda #<msg_sr_m55
        ldx #>msg_sr_m55
        jsr print_str

        lda #$55
        sta SR_INIT
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5a_end - fn_sr_m5a
        ldx #<fn_sr_m5a
        ldy #>fn_sr_m5a
        jsr write_file

        lda #$55
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5b_end - fn_sr_m5b
        ldx #<fn_sr_m5b
        ldy #>fn_sr_m5b
        jsr write_file

        lda #$55
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5c_end - fn_sr_m5c
        ldx #<fn_sr_m5c
        ldy #>fn_sr_m5c
        jsr write_file

        lda #$55
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5d_end - fn_sr_m5d
        ldx #<fn_sr_m5d
        ldy #>fn_sr_m5d
        jsr write_file
        lda #<msg_nl
        ldx #>msg_nl
        jsr print_str

        ; --------------------------------------------------------
        ; SR mode 5 (shift out under T2 control), SR init = $AA
        ; --------------------------------------------------------
        lda #<msg_sr_m5aa
        ldx #>msg_sr_m5aa
        jsr print_str

        lda #$aa
        sta SR_INIT
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5aaa_end - fn_sr_m5aaa
        ldx #<fn_sr_m5aaa
        ldy #>fn_sr_m5aaa
        jsr write_file

        lda #$aa
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5aab_end - fn_sr_m5aab
        ldx #<fn_sr_m5aab
        ldy #>fn_sr_m5aab
        jsr write_file

        lda #$aa
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5aac_end - fn_sr_m5aac
        ldx #<fn_sr_m5aac
        ldy #>fn_sr_m5aac
        jsr write_file

        lda #$aa
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5aad_end - fn_sr_m5aad
        ldx #<fn_sr_m5aad
        ldy #>fn_sr_m5aad
        jsr write_file
        lda #<msg_nl
        ldx #>msg_nl
        jsr print_str

        ; --------------------------------------------------------
        ; SR shift-in via T2 (legacy IT2 scenarios from old test 04 group 7)
        ; --------------------------------------------------------
        lda #<msg_sr_it2
        ldx #>msg_sr_it2
        jsr print_str

        jsr meas_sr_it2_ah
        lda #fn_sr_it2ah_end - fn_sr_it2ah
        ldx #<fn_sr_it2ah
        ldy #>fn_sr_it2ah
        jsr write_file

        jsr meas_sr_it2_al
        lda #fn_sr_it2al_end - fn_sr_it2al
        ldx #<fn_sr_it2al
        ldy #>fn_sr_it2al
        jsr write_file

        jsr meas_sr_it2_bh
        lda #fn_sr_it2bh_end - fn_sr_it2bh
        ldx #<fn_sr_it2bh
        ldy #>fn_sr_it2bh
        jsr write_file

        jsr meas_sr_it2_bl
        lda #fn_sr_it2bl_end - fn_sr_it2bl
        ldx #<fn_sr_it2bl
        ldy #>fn_sr_it2bl
        jsr write_file

        jsr meas_sr_it2_ch
        lda #fn_sr_it2ch_end - fn_sr_it2ch
        ldx #<fn_sr_it2ch
        ldy #>fn_sr_it2ch
        jsr write_file

        jsr meas_sr_it2_cl
        lda #fn_sr_it2cl_end - fn_sr_it2cl
        ldx #<fn_sr_it2cl
        ldy #>fn_sr_it2cl
        jsr write_file

        lda #<msg_nl
        ldx #>msg_nl
        jsr print_str

        ; --------------------------------------------------------
        ; Restore VIA state
        ; --------------------------------------------------------
        sei
        lda ACR_SAVE
        sta VIA_BASE+VIA_ACR
        lda IER_SAVE
        ora #$80            ; bit7=1: enable the bits that were set
        sta VIA_BASE+VIA_IER
        cli

        lda #<msg_done
        ldx #>msg_done
        jsr print_str

        rts

; ============================================================
; Subroutine: write_file
;
; Saves MEAS_BUF (256 bytes, $7F00-$7FFF) to a PRG file on
; device 8 using the PET-compatible SAVE routine (PET_SAVE).
;
; Entry: A = filename string length
;        X = low byte of filename string address
;        Y = high byte of filename string address
; On success: increments PASS_CNT, prints "."
; On error:   increments FAIL_CNT, prints "E"
; Clobbers: A, X, Y
; ============================================================
write_file:
        jsr SETNAM              ; set filename (A=len, X=addr_lo, Y=addr_hi)

        ; Save the current measurement ACR and restore the VIA to a
        ; KERNAL-safe state before any KERNAL I/O calls.
        sei
        lda VIA_BASE+VIA_ACR
        sta MEAS_ACR
        lda ACR_SAVE
        sta VIA_BASE+VIA_ACR
        lda #$ff
        sta VIA_BASE+VIA_T1LL
        sta VIA_BASE+VIA_T1LH   ; write latch high (clears IFR6; does not start timer)
        lda IER_SAVE
        ora #$80
        sta VIA_BASE+VIA_IER
        cli

        ; LFN=1, device=8, SA=0 -> SAVE writes PRG file to IEEE-488 disk
        lda #1
        ldx #8
        ldy #0
        jsr SETLFS

        ; store MEAS_BUF start address in ZP for PET_SAVE
        lda #<MEAS_BUF
        sta SAVE_START
        lda #>MEAS_BUF
        sta SAVE_START+1

        ; save MEAS_BUF ($7F00-$7FFF): A=ZP ptr to start, X=end lo, Y=end hi
        lda #SAVE_START
        ldx #<(MEAS_BUF+$100)
        ldy #>(MEAS_BUF+$100)
        jsr PET_SAVE
        bcs wf_err

        inc PASS_CNT
        lda #<msg_ok
        ldx #>msg_ok
        jsr print_str
        jsr wf_via_restore
        rts

wf_err:
        inc FAIL_CNT
        lda #<msg_err
        ldx #>msg_err
        jsr print_str
        jsr wf_via_restore
        rts

; ============================================================
; Subroutine: wf_via_restore
;
; Restores the VIA ACR to measurement state after KERNAL I/O.
; ============================================================
wf_via_restore:
        sei
        lda MEAS_ACR
        sta VIA_BASE+VIA_ACR
        lda #IFR_T1|IFR_T2|IFR_SR  ; bit7=0: disable these IRQ sources
        sta VIA_BASE+VIA_IER
        cli
        rts

; ============================================================
; Subroutine: print_str
;
; Prints a null-terminated string via CHROUT.
; Entry: A = low byte of address, X = high byte
; ============================================================
print_str:
        sta STRPTR
        stx STRPTR+1
ps_lp:
        ldy #0
        lda (STRPTR),y
        beq ps_done
        jsr CHROUT
        inc STRPTR
        bne ps_lp
        inc STRPTR+1
        jmp ps_lp
ps_done:
        rts

.include "kernal.inc"     ; SETNAM, SETLFS, PET_SAVE, PET_LOAD, KERNAL ZP defs

; ============================================================
; Message strings (null-terminated, CBM uppercase charset)
; ============================================================
msg_banner: .byte "VIA SR TEST DATA GENERATOR", $0d
            .byte "--------------------------", $0d, 0
msg_sr_m1:  .byte "SR MODE1...", 0
msg_sr_m1n: .byte "SR MODE1 NO ARM...", 0
msg_sr_m45: .byte "SR MODE4 SR=$55...", 0
msg_sr_m4aa:.byte "SR MODE4 SR=$AA...", 0
msg_sr_m55: .byte "SR MODE5 SR=$55...", 0
msg_sr_m5aa:.byte "SR MODE5 SR=$AA...", 0
msg_sr_it2: .byte "SR SHIFT-IN VIA T2...", 0
msg_done:   .byte "DONE.", $0d, 0
msg_ok:     .byte ".", 0
msg_err:    .byte "E", 0
msg_nl:     .byte $0d, 0

; ============================================================
; Filename strings
; ============================================================
fn_sr_m1a:    .byte "V.SR.M1G2.A"
fn_sr_m1a_end:
