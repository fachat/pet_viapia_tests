fn_sr_m5d_end:
fn_sr_m5aaa:  .byte "VIA.SR.M5.AA.A"
fn_sr_m5aaa_end:
fn_sr_m5aab:  .byte "VIA.SR.M5.AA.B"
fn_sr_m5aab_end:
