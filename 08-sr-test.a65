; ============================================================
; 08-sr-test.a65
; VIA Shift Register Tests
;
; Tests the 6522 VIA shift register at $E840 on the PET 4032.
; Reference timing data (produced by via_sr_test_gen.prg) must
; be present on device 8 (IEEE-488 disk drive) before running
; the mode 1 tests.
;
; Requires the userport test fixture:
;   Pin 5 (PIA1 PA7)  ->  Pin 6  (CB1) : PIA1 PA7 drives CB1 clock
;   Pin L  (VIA PA7)  <-> Pin M  (CB2) : PA7 / CB2 loopback (data)
;
; Test groups:
;
;   Group 1 - SR mode 0 (disabled): external CB1 clock
;     In mode 0 (ACR SR = 000) CB1 rising edges still shift data
;     from CB2 into SR (left-shift; new bit at bit 0).  The VIA
;     does not count bits and IFR.SR is never set.
;
;     1: Complete mode 0 sequence:
;        Setup: DDRA=$00, ACR SR=0, CB1 hi via PIA1 PA7,
;               CB2 hi output via PCR, SR=$00.
;        Steps: CB1 lo/hi cycles verify SR=$01, $03, $06;
;               8-iteration loop with alternating CB2 verifies
;               SR=$AA and IFR.SR=0 throughout.
;
;   Group 2 - SR mode 1: shift in under T2 control
;     In mode 1 (ACR SR = 001) T2 underflows clock the SR.
;     CB2 is the data input (held high via PA7 loopback).
;     After 8 bits the IFR.SR bit is set.
;     256 SR samples are compared against reference files.
;
;     2A: SR mode 1, T2 initial value = $0110  (file: VIA.SR.M1.A)
;     2B: SR mode 1, T2 initial value = $0220  (file: VIA.SR.M1.B)
;     2C: SR mode 1, T2 initial value = $0330  (file: VIA.SR.M1.C)
;     2D: SR mode 1, T2 initial value = $0440  (file: VIA.SR.M1.D)
;
;   Group 3 - SR mode 1 (no arm read): shift in under T2 control
;     Identical to Group 2 but the SR read that arms shifting is
;     omitted.  The first shift clock therefore occurs on the first
;     T2 underflow after ACR is set to mode 1.
;
;     3A: SR mode 1 no-arm, T2 initial value = $0110  (file: VIA.SR.M1N.A)
;     3B: SR mode 1 no-arm, T2 initial value = $0220  (file: VIA.SR.M1N.B)
;     3C: SR mode 1 no-arm, T2 initial value = $0330  (file: VIA.SR.M1N.C)
;     3D: SR mode 1 no-arm, T2 initial value = $0440  (file: VIA.SR.M1N.D)
;
;   Group 4 - SR mode 1 IFR poll: shift in under T2 control
;     Identical setup to Group 2 (SR mode 1, armed).  Instead of
;     sampling the SR into a buffer and comparing to reference data,
;     polls IFR.SR up to 256 times until it sets.  On pass the
;     iteration count (number of polls until IFR.SR set) is printed.
;     IFR.SR not set within 256 iterations is a fail.
;
;     4A: SR mode 1 IFR poll, T2 = $0110
;     4B: SR mode 1 IFR poll, T2 = $0220
;     4C: SR mode 1 IFR poll, T2 = $0330
;     4D: SR mode 1 IFR poll, T2 = $0440
;
;   Group 5 - SR mode 1 no-arm IFR poll: shift in under T2 control
;     Identical to Group 4 but the SR arm read is omitted, matching
;     the Group 3 (meas_sr_mode1_noarm) setup variant.
;
;     5A: SR mode 1 no-arm IFR poll, T2 = $0110
;     5B: SR mode 1 no-arm IFR poll, T2 = $0220
;     5C: SR mode 1 no-arm IFR poll, T2 = $0330
;     5D: SR mode 1 no-arm IFR poll, T2 = $0440
;
;   Group 6 - SR mode 3: shift in under external CB1 control
;     In mode 3 (ACR SR = 011) CB1 rising edges shift data from CB2
;     into the SR, MSB first.  After 8 edges IFR.SR is set.
;     PA7 output drives CB2 via loopback; PIA1 PA7 output drives CB1
;     via loopback.  The data byte is bit-banged in MSB-first order.
;     Each pre-shift IFR.SR=0 check and the post-shift IFR.SR=1 check
;     verify correct flag behaviour.  SR is read back and compared to
;     the original data byte; IFR.SR is verified clear after the read.
;
;     6A: SR mode 3, data = $55
;     6B: SR mode 3, data = $AA
;     6C: SR mode 3, data = $A5
;     6D: SR mode 3, data = $5A
;
;   Group 7 - SR mode 5: shift out under T2 control, SR init = $55
;     In mode 5 (ACR SR = 101) T2 underflows clock the SR.
;     CB1 is the VIA output clock; CB2 is the VIA data output.
;     Both are read back via loopback: CB1->PIA1 PA7, CB2->VIA PA7.
;     SR is armed by writing $55 to SR after setting ACR to mode 5.
;     256 combined CB1/CB2 samples are compared against reference files.
;
;     7A: SR mode 5 SR=$55, T2 initial value = $0110  (file: VIA.SR.M5.55.A)
;     7B: SR mode 5 SR=$55, T2 initial value = $0220  (file: VIA.SR.M5.55.B)
;     7C: SR mode 5 SR=$55, T2 initial value = $0330  (file: VIA.SR.M5.55.C)
;     7D: SR mode 5 SR=$55, T2 initial value = $0440  (file: VIA.SR.M5.55.D)
;
;   Group 8 - SR mode 5: shift out under T2 control, SR init = $AA
;     Identical to Group 7 but SR is armed by writing $AA to SR.
;
;     8A: SR mode 5 SR=$AA, T2 initial value = $0110  (file: VIA.SR.M5.AA.A)
;     8B: SR mode 5 SR=$AA, T2 initial value = $0220  (file: VIA.SR.M5.AA.B)
;     8C: SR mode 5 SR=$AA, T2 initial value = $0330  (file: VIA.SR.M5.AA.C)
;     8D: SR mode 5 SR=$AA, T2 initial value = $0440  (file: VIA.SR.M5.AA.D)
;
;   Group 9 - SR mode 4 CB1 poll, SR init = $55
;     Mode 4 (free-running T2 shift-out) continuously repeats the
;     shifted byte.  This group reconstructs 4 consecutive bytes by
;     polling CB1 low/high and sampling CB2 via VIA PA7.  The first
;     reconstructed byte becomes the reference; bytes 2-4 must match
;     it.  IFR.SR must stay clear before every bit and after every
;     byte.  On timeout FAIL_IDX = $FF and SR_IFR_COUNT reports the
;     number of successfully reconstructed bytes.
;
;     9A: SR mode 4 CB1 poll SR=$55 T2=$011c
;     9B: SR mode 4 CB1 poll SR=$55 T2=$0220
;     9C: SR mode 4 CB1 poll SR=$55 T2=$0330
;     9D: SR mode 4 CB1 poll SR=$55 T2=$0440
;
;   Group 10 - SR mode 4 CB1 poll, SR init = $AA
;     Identical to Group 9 but SR is armed with $AA.
;
;     10A: SR mode 4 CB1 poll SR=$AA T2=$011c
;     10B: SR mode 4 CB1 poll SR=$AA T2=$0220
;     10C: SR mode 4 CB1 poll SR=$AA T2=$0330
;     10D: SR mode 4 CB1 poll SR=$AA T2=$0440
;
;   Group 11 - SR mode 7: shift out under external CB1 control
;     In mode 7 (ACR SR = 111) CB1 is an external clock input driven
;     via PIA1 PA7 loopback.  Each falling edge of CB1 causes the VIA
;     to present the next output bit on CB2 (MSB first).  After 8
;     edges IFR.SR is set.  CB2 is read back via VIA PA7 (DDRA=$00).
;     Each pre-shift IFR.SR=0 check and the post-shift IFR.SR=1 check
;     verify correct flag behaviour.  The reconstructed byte is
;     compared to the original payload byte written to the SR.
;
;     11A: SR mode 7, data = $55
;     11B: SR mode 7, data = $AA
;     11C: SR mode 7, data = $5A
;     11D: SR mode 7, data = $A5
;
; For Groups 2 and 3 only SR_IFR_PRE (expected: 0) is verified after
; each run; a mismatch is reported as a FAIL and the file comparison
; is skipped for that test.  SR_IFR_POST is NOT checked: the
; measurement subroutines sample IFR immediately after the shift loop
; so the flag may not yet have been raised.
;
; The measurement subroutine (meas_sr_mode1) is byte-for-byte
; identical to the one in 08-sr-test-gen.a65, ensuring that the
; measured values match the pre-recorded reference data.
;
; Target   : Commodore PET 4032
; Assembler: xa65  (command: xa -W -XMASM)
; Load     : LOAD then RUN  -- or autostart in VICE
; ============================================================

; ============================================================
; Common hardware and zero-page definitions
; ============================================================
#include "hw.inc"

; ============================================================
; Zero-page ($09-$1E - file-specific)
; ============================================================
ACR_SAVE       = $09        ; saved VIA ACR value
IER_SAVE       = $0A        ; saved VIA IER value
TMP            = $0B        ; scratch byte
MEAS_ACR       = $0C        ; measurement ACR, saved/restored around KERNAL calls
FAIL_IDX       = $0D        ; index of first mismatch byte from compare_file
SR_T2_LO       = $0E        ; T2 initial value low byte (for meas_sr_mode1)
SR_T2_HI       = $0F        ; T2 initial value high byte (for meas_sr_mode1)
FAIL_STEP      = $10        ; step number where mode 0 test last failed
PCR_SAVE       = $11        ; saved VIA PCR (mode 0 test save/restore)
PIA1_DDRA_SAVE = $12        ; saved PIA1 DDRA (mode 0 test save/restore)
PIA1_ORA_SAVE  = $13        ; saved PIA1 ORA data (mode 0 test save/restore)
SR_INIT        = $14        ; initial value written to SR in meas_sr_mode5 before sampling
SR_IFR_PRE     = $15        ; IFR & IFR_SR sampled before arming SR (expected: 0)
SR_IFR_POST    = $16        ; IFR & IFR_SR sampled after sample loop (expected: IFR_SR)
SR_M3_DATA     = $17        ; original data byte passed to test_sr_mode3
SR_M3_SHIFT    = $18        ; working copy of data, shifted left each iteration
SR_IFR_COUNT   = $19        ; iteration count from test_sr_mode1_ifr / _noarm_ifr
SR_M5_RESULT   = $1A        ; reconstructed byte in test_sr_mode4_cb1
SR_M5_BITNO    = $1B        ; current bit number (1..32) in test_sr_mode4_cb1
SR_M7_DATA     = $1C        ; payload byte for test_sr_mode7_cb1
SR_M7_RESULT   = $1D        ; reconstructed byte in test_sr_mode7_cb1
SR_M7_BITNO    = $1E        ; current bit number (1..8) in test_sr_mode7_cb1
SR_M4_EXPECT   = $1F        ; first reconstructed byte in test_sr_mode4_cb1

; ============================================================
; Memory buffers
; ============================================================
MEAS_BUF = $7E00            ; measurement result buffer (256 bytes, $7E00-$7EFF)
; NOTE: REF_BUF must equal MEAS_BUF in 08-sr-test-gen.a65 ($7F00) so that
; the PRG file saved by via_sr_test_gen loads at REF_BUF without address override.
REF_BUF  = $7F00            ; reference data buffer    (256 bytes, $7F00-$7FFF)

; ============================================================
; .PRG file header
; ============================================================
* = $0401 - 2
        .word $0401

* = $0401
        .word basic_end
        .word 10
        .byte $9e
        .byte "1037"
        .byte 0
basic_end:
        .word 0

; ============================================================
; Machine code entry point  ($040D = 1037 decimal)
;
; SYS 1037 executes the 3-byte JMP at $040D, which jumps over
; the included measurement subroutines to main.  Placing the
; measurement code at $0410 (immediately after the JMP, and at
; the same address in via_sr_test_gen.prg) guarantees identical
; branch-target page alignment and thus cycle-accurate timing
; reproducibility between the generator and test runs.
; ============================================================
* = $040D
        jmp main            ; skip measurement code; land at main below

.include "08-meas.i65"   ; meas_sr_mode1 subroutine assembled at $0410

; ============================================================
; Main entry point
; ============================================================
main:
        lda #0
        sta PASS_CNT
        sta FAIL_CNT
        sta FAIL_STEP

        lda #$93
        jsr CHROUT

        ; Print IOBASE address in hex on first line
        lda #<msg_iobase
        ldx #>msg_iobase
        jsr print_str
        lda #>IOBASE
        jsr print_hex
        lda #<IOBASE
        jsr print_hex
        lda #$0d
        jsr CHROUT

        lda #<msg_banner
        ldx #>msg_banner
        jsr print_str

        ; save VIA state and disable T1/T2/SR interrupts
        sei
        lda VIA_BASE+VIA_ACR
        sta ACR_SAVE
        lda VIA_BASE+VIA_IER
        sta IER_SAVE
        lda #IFR_T1|IFR_T2|IFR_SR
        sta VIA_BASE+VIA_IER
        cli

        ; --------------------------------------------------------
        ; Group 1 - SR mode 0 (external CB1 clock)
        ; --------------------------------------------------------
        lda #<msg_grp1
        ldx #>msg_grp1
        jsr print_str

        lda #<msg_t1
        ldx #>msg_t1
        jsr print_str
        jsr test_sr_mode0
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 2 - SR mode 1 (shift in under T2 control)
        ;
        ; Ensure PIA1 PA7 is an INPUT before mode 1 measurements.
        ; In SR mode 1 the VIA drives CB1 as an output clock; if
        ; PIA1 PA7 were still an output it would conflict on CB1.
        ; --------------------------------------------------------
        lda #<msg_grp2
        ldx #>msg_grp2
        jsr print_str

        sei
        lda PIA1_BASE+PIA_CRA
        pha                         ; save CRA
        and #$FB                    ; select DDRA (bit 2 = 0)
        sta PIA1_BASE+PIA_CRA
        lda PIA1_BASE+PIA_ORA       ; read DDRA
        and #$7F                    ; clear PA7 -> PA7 = input
        sta PIA1_BASE+PIA_ORA
        pla
        sta PIA1_BASE+PIA_CRA       ; restore CRA
        cli

        lda #<msg_t2a
        ldx #>msg_t2a
        jsr print_str
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode1
        jsr check_ifr_pre_post      ; verify IFR_PRE=0
        bne t2a_done
        lda #fn_sr_m1a_end - fn_sr_m1a
        ldx #<fn_sr_m1a
        ldy #>fn_sr_m1a
        jsr compare_file
t2a_done:
        jsr print_result

        lda #<msg_t2b
        ldx #>msg_t2b
        jsr print_str
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode1
        jsr check_ifr_pre_post
        bne t2b_done
        lda #fn_sr_m1b_end - fn_sr_m1b
        ldx #<fn_sr_m1b
        ldy #>fn_sr_m1b
        jsr compare_file
t2b_done:
        jsr print_result

        lda #<msg_t2c
        ldx #>msg_t2c
        jsr print_str
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode1
        jsr check_ifr_pre_post
        bne t2c_done
        lda #fn_sr_m1c_end - fn_sr_m1c
        ldx #<fn_sr_m1c
        ldy #>fn_sr_m1c
        jsr compare_file
t2c_done:
        jsr print_result

        lda #<msg_t2d
        ldx #>msg_t2d
        jsr print_str
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode1
        jsr check_ifr_pre_post
        bne t2d_done
        lda #fn_sr_m1d_end - fn_sr_m1d
        ldx #<fn_sr_m1d
        ldy #>fn_sr_m1d
        jsr compare_file
t2d_done:
        jsr print_result

        ; --------------------------------------------------------
        ; Group 3 - SR mode 1, no arm read (shift in under T2 control)
        ;
        ; Identical to Group 2 but the SR read that arms shifting is
        ; omitted; the first shift clock occurs on the first T2
        ; underflow after ACR is set to mode 1.
        ; PIA1 PA7 remains an input (already set for Group 2).
        ; --------------------------------------------------------
        lda #<msg_grp3
        ldx #>msg_grp3
        jsr print_str

        lda #<msg_t3a
        ldx #>msg_t3a
        jsr print_str
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        jsr check_ifr_pre_post
        bne t3a_done
        lda #fn_sr_m1na_end - fn_sr_m1na
        ldx #<fn_sr_m1na
        ldy #>fn_sr_m1na
        jsr compare_file
t3a_done:
        jsr print_result

        lda #<msg_t3b
        ldx #>msg_t3b
        jsr print_str
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        jsr check_ifr_pre_post
        bne t3b_done
        lda #fn_sr_m1nb_end - fn_sr_m1nb
        ldx #<fn_sr_m1nb
        ldy #>fn_sr_m1nb
        jsr compare_file
t3b_done:
        jsr print_result

        lda #<msg_t3c
        ldx #>msg_t3c
        jsr print_str
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        jsr check_ifr_pre_post
        bne t3c_done
        lda #fn_sr_m1nc_end - fn_sr_m1nc
        ldx #<fn_sr_m1nc
        ldy #>fn_sr_m1nc
        jsr compare_file
t3c_done:
        jsr print_result

        lda #<msg_t3d
        ldx #>msg_t3d
        jsr print_str
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        jsr check_ifr_pre_post
        bne t3d_done
        lda #fn_sr_m1nd_end - fn_sr_m1nd
        ldx #<fn_sr_m1nd
        ldy #>fn_sr_m1nd
        jsr compare_file
t3d_done:
        jsr print_result

        ; --------------------------------------------------------
        ; Group 4 - SR mode 1 IFR poll (shift in under T2 control)
        ;
        ; Same setup as Group 2 (armed mode 1) but instead of sampling
        ; SR into a buffer, polls IFR.SR up to 256 iterations until it
        ; sets.  The iteration count is printed on pass.
        ; PIA1 PA7 is an input (already set for Group 2).
        ; --------------------------------------------------------
        lda #<msg_grp4
        ldx #>msg_grp4
        jsr print_str

        lda #<msg_t4a
        ldx #>msg_t4a
        jsr print_str
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr test_sr_mode1_ifr
        jsr print_result_cnt

        lda #<msg_t4b
        ldx #>msg_t4b
        jsr print_str
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr test_sr_mode1_ifr
        jsr print_result_cnt

        lda #<msg_t4c
        ldx #>msg_t4c
        jsr print_str
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr test_sr_mode1_ifr
        jsr print_result_cnt

        lda #<msg_t4d
        ldx #>msg_t4d
        jsr print_str
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr test_sr_mode1_ifr
        jsr print_result_cnt

        ; --------------------------------------------------------
        ; Group 5 - SR mode 1 no-arm IFR poll (shift in under T2 control)
        ;
        ; Same as Group 4 but the SR arm read is omitted, matching the
        ; Group 3 (meas_sr_mode1_noarm) setup variant.
        ; --------------------------------------------------------
        lda #<msg_grp5
        ldx #>msg_grp5
        jsr print_str

        lda #<msg_t5a
        ldx #>msg_t5a
        jsr print_str
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr test_sr_mode1_noarm_ifr
        jsr print_result

        lda #<msg_t5b
        ldx #>msg_t5b
        jsr print_str
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr test_sr_mode1_noarm_ifr
        jsr print_result

        lda #<msg_t5c
        ldx #>msg_t5c
        jsr print_str
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr test_sr_mode1_noarm_ifr
        jsr print_result

        lda #<msg_t5d
        ldx #>msg_t5d
        jsr print_str
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr test_sr_mode1_noarm_ifr
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 6 - SR mode 3 (shift in under external CB1 control)
        ;
        ; CB1 is the external clock input (driven via PIA1 PA7 loopback).
        ; CB2 is the data input (driven via VIA PA7 loopback).
        ; PA7 = output (DDRA=$80); PIA1 PA7 = output, drives CB1 clock.
        ; Data bytes $55, $AA, $A5, $5A are shifted in MSB-first.
        ; --------------------------------------------------------
        lda #<msg_grp6
        ldx #>msg_grp6
        jsr print_str

        lda #<msg_t6a
        ldx #>msg_t6a
        jsr print_str
        lda #$55
        jsr test_sr_mode3
        jsr print_result

        lda #<msg_t6b
        ldx #>msg_t6b
        jsr print_str
        lda #$aa
        jsr test_sr_mode3
        jsr print_result

        lda #<msg_t6c
        ldx #>msg_t6c
        jsr print_str
        lda #$a5
        jsr test_sr_mode3
        jsr print_result

        lda #<msg_t6d
        ldx #>msg_t6d
        jsr print_str
        lda #$5a
        jsr test_sr_mode3
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 7 - SR mode 5 (shift out under T2 control), SR init = $55
        ;
        ; PIA1 PA7 remains an input (VIA drives CB1 as output clock).
        ; meas_sr_mode5 sets VIA DDRA=$00 internally so VIA PA7 is
        ; an input to read CB2 data via the loopback cable.
        ; --------------------------------------------------------
        lda #<msg_grp7
        ldx #>msg_grp7
        jsr print_str

        lda #<msg_t7a
        ldx #>msg_t7a
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5a_end - fn_sr_m5a
        ldx #<fn_sr_m5a
        ldy #>fn_sr_m5a
        jsr compare_file
        jsr print_result

        lda #<msg_t7b
        ldx #>msg_t7b
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5b_end - fn_sr_m5b
        ldx #<fn_sr_m5b
        ldy #>fn_sr_m5b
        jsr compare_file
        jsr print_result

        lda #<msg_t7c
        ldx #>msg_t7c
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5c_end - fn_sr_m5c
        ldx #<fn_sr_m5c
        ldy #>fn_sr_m5c
        jsr compare_file
        jsr print_result

        lda #<msg_t7d
        ldx #>msg_t7d
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5d_end - fn_sr_m5d
        ldx #<fn_sr_m5d
        ldy #>fn_sr_m5d
        jsr compare_file
        jsr print_result

        ; --------------------------------------------------------
        ; Group 8 - SR mode 5 (shift out under T2 control), SR init = $AA
        ; --------------------------------------------------------
        lda #<msg_grp8
        ldx #>msg_grp8
        jsr print_str

        lda #<msg_t8a
        ldx #>msg_t8a
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5aaa_end - fn_sr_m5aaa
        ldx #<fn_sr_m5aaa
        ldy #>fn_sr_m5aaa
        jsr compare_file
        jsr print_result

        lda #<msg_t8b
        ldx #>msg_t8b
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5aab_end - fn_sr_m5aab
        ldx #<fn_sr_m5aab
        ldy #>fn_sr_m5aab
        jsr compare_file
        jsr print_result

        lda #<msg_t8c
        ldx #>msg_t8c
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5aac_end - fn_sr_m5aac
        ldx #<fn_sr_m5aac
        ldy #>fn_sr_m5aac
        jsr compare_file
        jsr print_result

        lda #<msg_t8d
        ldx #>msg_t8d
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #fn_sr_m5aad_end - fn_sr_m5aad
        ldx #<fn_sr_m5aad
        ldy #>fn_sr_m5aad
        jsr compare_file
        jsr print_result

        ; --------------------------------------------------------
        ; Group 9 - SR mode 4 CB1 poll (free-running shift out via T2), SR init = $55
        ;
        ; Reconstructs four consecutive bytes by polling CB1 low/high
        ; and sampling CB2.  Byte 1 becomes the reference; bytes 2-4
        ; must match it while IFR.SR stays clear throughout.
        ; PIA1 PA7 must be an input (already set; VIA drives CB1).
        ; --------------------------------------------------------
        lda #<msg_grp9
        ldx #>msg_grp9
        jsr print_str

        lda #<msg_t9a
        ldx #>msg_t9a
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$1c
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr test_sr_mode4_cb1
        jsr print_result_m4

        lda #<msg_t9b
        ldx #>msg_t9b
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr test_sr_mode4_cb1
        jsr print_result_m4

        lda #<msg_t9c
        ldx #>msg_t9c
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr test_sr_mode4_cb1
        jsr print_result_m4

        lda #<msg_t9d
        ldx #>msg_t9d
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr test_sr_mode4_cb1
        jsr print_result_m4

        ; --------------------------------------------------------
        ; Group 10 - SR mode 4 CB1 poll (free-running shift out via T2), SR init = $AA
        ;
        ; Identical to Group 9 but SR is armed with $AA.
        ; --------------------------------------------------------
        lda #<msg_grp10
        ldx #>msg_grp10
        jsr print_str

        lda #<msg_t10a
        ldx #>msg_t10a
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$1c
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr test_sr_mode4_cb1
        jsr print_result_m4

        lda #<msg_t10b
        ldx #>msg_t10b
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr test_sr_mode4_cb1
        jsr print_result_m4

        lda #<msg_t10c
        ldx #>msg_t10c
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr test_sr_mode4_cb1
        jsr print_result_m4

        lda #<msg_t10d
        ldx #>msg_t10d
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr test_sr_mode4_cb1
        jsr print_result_m4

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 11 - SR mode 7 (shift out under external CB1 control)
        ;
        ; CB1 is the external clock input (driven via PIA1 PA7 loopback).
        ; CB2 is the VIA data output, read back via VIA PA7 (DDRA=$00).
        ; Each falling edge of CB1 causes the VIA to present the next
        ; output bit (MSB first) on CB2.  After 8 edges IFR.SR is set.
        ; --------------------------------------------------------
        lda #<msg_grp11
        ldx #>msg_grp11
        jsr print_str

        lda #<msg_t11a
        ldx #>msg_t11a
        jsr print_str
        lda #$55
        jsr test_sr_mode7_cb1
        jsr print_result

        lda #<msg_t11b
        ldx #>msg_t11b
        jsr print_str
        lda #$aa
        jsr test_sr_mode7_cb1
        jsr print_result

        lda #<msg_t11c
        ldx #>msg_t11c
        jsr print_str
        lda #$5a
        jsr test_sr_mode7_cb1
        jsr print_result

        lda #<msg_t11d
        ldx #>msg_t11d
        jsr print_str
        lda #$a5
        jsr test_sr_mode7_cb1
        jsr print_result

        ; --------------------------------------------------------
        ; Restore VIA state and print summary
        ; --------------------------------------------------------
        sei
        lda ACR_SAVE
        sta VIA_BASE+VIA_ACR
        lda IER_SAVE
        ora #$80
        sta VIA_BASE+VIA_IER
        cli

        lda #<msg_divider
        ldx #>msg_divider
        jsr print_str

        lda FAIL_CNT
        bne main_fail
        lda #<msg_all_pass
        ldx #>msg_all_pass
        jsr print_str
        jmp main_done
main_fail:
        lda #<msg_some_fail
        ldx #>msg_some_fail
        jsr print_str
main_done:
        rts

; ============================================================
; Test subroutines
; ============================================================
.include "08-tests.i65"

; ============================================================
; Loads 256 bytes from a CBM PRG file on device 8 into REF_BUF,
; then compares REF_BUF byte-by-byte against MEAS_BUF.
;
; Entry: A = filename length
;        X = low byte of filename address
;        Y = high byte of filename address
; Returns: A = 0 (pass), A = 1 (fail: mismatch or file error)
; Clobbers: A, X, Y
; ============================================================
compare_file:
        jsr SETNAM              ; set filename (A=len, X=addr_lo, Y=addr_hi)

        ; Save measurement ACR; restore VIA to KERNAL-safe state.
        sei
        lda VIA_BASE+VIA_ACR
        sta MEAS_ACR
        lda ACR_SAVE
        sta VIA_BASE+VIA_ACR
        lda #$ff
        sta VIA_BASE+VIA_T1LL
        sta VIA_BASE+VIA_T1LH   ; write latch high (clears IFR6; does not start timer)
        lda IER_SAVE
        ora #$80
        sta VIA_BASE+VIA_IER
        cli

        ; LFN=1, device=8, SA=0 -> LOAD uses address embedded in PRG header ($7F00)
        lda #1
        ldx #8
        ldy #0
        jsr SETLFS

        ; load PRG file: A=0 (load); load address from PRG header -> REF_BUF
        lda #0
        jsr PET_LOAD
        bcs cf_file_err

        jsr cf_via_restore

        ; compare MEAS_BUF against REF_BUF
        ldx #0
cf_cmp_lp:
        lda MEAS_BUF,x
        cmp REF_BUF,x
        bne cf_mismatch
        inx
        bne cf_cmp_lp

        lda #0              ; pass
        rts

cf_mismatch:
        stx FAIL_IDX        ; save index of first mismatching byte
        lda #1              ; fail - mismatch
        rts

cf_file_err:
        jsr cf_via_restore
        lda #$ff
        sta FAIL_IDX        ; flag as file error (no valid byte index)
        lda #1              ; fail - file not found / load error
        rts

; ============================================================
; Subroutine: cf_via_restore
;
; Restores the VIA ACR to measurement state after PET_LOAD.
; ============================================================
cf_via_restore:
        sei
        lda MEAS_ACR
        sta VIA_BASE+VIA_ACR
        lda #IFR_T1|IFR_T2|IFR_SR  ; bit7=0: disable these IRQ sources
        sta VIA_BASE+VIA_IER
        cli
        rts

; ============================================================
; Subroutine: wait_key
;
; Prints "PRESS ANY KEY", blocks until a key is pressed, then
; clears the screen so the next section starts at the top.
; ============================================================
wait_key:
        lda #<msg_press_key
        ldx #>msg_press_key
        jsr print_str
wk_lp:  jsr GETIN
        beq wk_lp
        lda #$93
        jsr CHROUT
        rts

; ============================================================
; Subroutine: print_result
;
; Prints "OK" or "FAIL" and updates PASS_CNT / FAIL_CNT.
; Input: A = 0 -> pass, A != 0 -> fail
; ============================================================
print_result:
        cmp #0
        bne pr_fail
        inc PASS_CNT
        lda #<msg_ok
        ldx #>msg_ok
        jsr print_str
        rts
pr_fail:
        inc FAIL_CNT
        lda #<msg_fail
        ldx #>msg_fail
        jsr print_str
        lda FAIL_IDX        ; byte index from compare_file (or FAIL_STEP for mode 0)
        jsr print_hex
        lda #$0d
        jsr CHROUT
        rts

; ============================================================
; Subroutine: print_result_cnt
;
; Like print_result but on pass prints "OK @XX" where XX is the
; SR_IFR_COUNT value (iteration count) as two hex digits, then
; a newline.  Used by test_sr_mode1_ifr.
; Input: A = 0 -> pass, A != 0 -> fail
; ============================================================
print_result_cnt:
        cmp #0
        bne prc_fail
        inc PASS_CNT
        lda #<msg_ok_cnt
        ldx #>msg_ok_cnt
        jsr print_str
        lda SR_IFR_COUNT
        jsr print_hex
        lda #$0d
        jsr CHROUT
        rts
prc_fail:
        inc FAIL_CNT
        lda #<msg_fail
        ldx #>msg_fail
        jsr print_str
        lda FAIL_IDX
        jsr print_hex
        lda #$0d
        jsr CHROUT
        rts

; ============================================================
; Subroutine: print_result_m4
;
; Like print_result, but for mode 4 CB1-poll failures a timeout
; prints "FAIL @FF NN" where NN is SR_IFR_COUNT (successful bytes).
; Input: A = 0 -> pass, A != 0 -> fail
; ============================================================
print_result_m4:
        cmp #0
        bne prm4_fail
        inc PASS_CNT
        lda #<msg_ok
        ldx #>msg_ok
        jsr print_str
        rts
prm4_fail:
        inc FAIL_CNT
        lda #<msg_fail
        ldx #>msg_fail
        jsr print_str
        lda FAIL_IDX
        jsr print_hex
        lda FAIL_IDX
        cmp #$ff
        bne prm4_nl
        lda #' '
        jsr CHROUT
        lda SR_IFR_COUNT
        jsr print_hex
prm4_nl:
        lda #$0d
        jsr CHROUT
        rts

; ============================================================
; Subroutine: print_hex
;
; Prints a byte as two uppercase hex digits via CHROUT.
; Entry: A = byte to print
; ============================================================
print_hex:
        pha
        lsr
        lsr
        lsr
        lsr
        jsr print_nybble
        pla
        and #$0f
        jsr print_nybble
        rts

print_nybble:
        cmp #10
        bcc ph_digit
        adc #6                      ; carry set: 'A'-'9'-1=7 -> 'A'..'F'
ph_digit:
        adc #'0'
        jsr CHROUT
        rts

; ============================================================
; Subroutine: print_str
;
; Prints a null-terminated string via CHROUT.
; Entry: A = low byte of address, X = high byte
; ============================================================
print_str:
        sta STRPTR
        stx STRPTR+1
ps_lp:
        ldy #0
        lda (STRPTR),y
        beq ps_done
        jsr CHROUT
        inc STRPTR
        bne ps_lp
        inc STRPTR+1
        jmp ps_lp
ps_done:
        rts

.include "kernal.inc"     ; SETNAM, SETLFS, PET_SAVE, PET_LOAD, KERNAL ZP defs

; ============================================================
; Message strings (null-terminated, CBM uppercase charset)
; ============================================================
msg_iobase:    .byte "IOBASE=$", 0
msg_banner:    .byte "VIA SR TEST MODULE", $0d
               .byte "------------------", $0d, 0

msg_grp1:      .byte "GRP1: SR MODE 0 (EXT CB1 CLOCK)", $0d, 0
msg_t1:        .byte "  1  SR MODE0 CB1/CB2 SEQ: ", 0

msg_grp2:      .byte "GRP2: SR MODE 1 (SHIFT IN VIA T2)", $0d, 0
msg_t2a:       .byte "  2A SR MODE1 T2=$0110: ", 0
msg_t2b:       .byte "  2B SR MODE1 T2=$0220: ", 0
msg_t2c:       .byte "  2C SR MODE1 T2=$0330: ", 0
msg_t2d:       .byte "  2D SR MODE1 T2=$0440: ", 0

msg_grp3:      .byte "GRP3: SR MODE 1 NO ARM (T2 SHIFT IN)", $0d, 0
msg_t3a:       .byte "  3A SR M1NOARM T2=$0110: ", 0
msg_t3b:       .byte "  3B SR M1NOARM T2=$0220: ", 0
msg_t3c:       .byte "  3C SR M1NOARM T2=$0330: ", 0
msg_t3d:       .byte "  3D SR M1NOARM T2=$0440: ", 0

msg_grp4:      .byte "GRP4: SR MODE 1 IFR POLL (VIA T2)", $0d, 0
msg_t4a:       .byte "  4A SR M1IFR T2=$0110: ", 0
msg_t4b:       .byte "  4B SR M1IFR T2=$0220: ", 0
msg_t4c:       .byte "  4C SR M1IFR T2=$0330: ", 0
msg_t4d:       .byte "  4D SR M1IFR T2=$0440: ", 0

msg_grp5:      .byte "GRP5: SR MODE 1 NO ARM IFR POLL (T2)", $0d, 0
msg_t5a:       .byte "  5A SR M1NIFR T2=$0110: ", 0
msg_t5b:       .byte "  5B SR M1NIFR T2=$0220: ", 0
msg_t5c:       .byte "  5C SR M1NIFR T2=$0330: ", 0
msg_t5d:       .byte "  5D SR M1NIFR T2=$0440: ", 0

msg_grp6:      .byte "GRP6: SR MODE 3 (SHIFT IN EXT CB1)", $0d, 0
msg_t6a:       .byte "  6A SR MODE3 DATA=$55: ", 0
msg_t6b:       .byte "  6B SR MODE3 DATA=$AA: ", 0
msg_t6c:       .byte "  6C SR MODE3 DATA=$A5: ", 0
msg_t6d:       .byte "  6D SR MODE3 DATA=$5A: ", 0

msg_grp7:      .byte "GRP7: SR MODE 5 (OUT VIA T2) SR=$55", $0d, 0
msg_t7a:       .byte "  7A SR MODE5 SR=$55 T2=$0110: ", 0
msg_t7b:       .byte "  7B SR MODE5 SR=$55 T2=$0220: ", 0
msg_t7c:       .byte "  7C SR MODE5 SR=$55 T2=$0330: ", 0
msg_t7d:       .byte "  7D SR MODE5 SR=$55 T2=$0440: ", 0

msg_grp8:      .byte "GRP8: SR MODE 5 (OUT VIA T2) SR=$AA", $0d, 0
msg_t8a:       .byte "  8A SR MODE5 SR=$AA T2=$0110: ", 0
msg_t8b:       .byte "  8B SR MODE5 SR=$AA T2=$0220: ", 0
msg_t8c:       .byte "  8C SR MODE5 SR=$AA T2=$0330: ", 0
msg_t8d:       .byte "  8D SR MODE5 SR=$AA T2=$0440: ", 0

msg_grp9:      .byte "GRP9: SR MODE 4 CB1 POLL SR=$55", $0d, 0
msg_t9a:       .byte "  9A SR M4CB1 SR=$55 T2=$011C: ", 0
msg_t9b:       .byte "  9B SR M4CB1 SR=$55 T2=$0220: ", 0
msg_t9c:       .byte "  9C SR M4CB1 SR=$55 T2=$0330: ", 0
msg_t9d:       .byte "  9D SR M4CB1 SR=$55 T2=$0440: ", 0

msg_grp10:     .byte "GRP10: SR MODE 4 CB1 POLL SR=$AA", $0d, 0
msg_t10a:      .byte "  10A SR M4CB1 SR=$AA T2=$011C: ", 0
msg_t10b:      .byte "  10B SR M4CB1 SR=$AA T2=$0220: ", 0
msg_t10c:      .byte "  10C SR M4CB1 SR=$AA T2=$0330: ", 0
msg_t10d:      .byte "  10D SR M4CB1 SR=$AA T2=$0440: ", 0

msg_grp11:     .byte "GRP11: SR MODE 7 (OUT EXT CB1)", $0d, 0
msg_t11a:      .byte "  11A SR MODE7 DATA=$55: ", 0
msg_t11b:      .byte "  11B SR MODE7 DATA=$AA: ", 0
msg_t11c:      .byte "  11C SR MODE7 DATA=$5A: ", 0
msg_t11d:      .byte "  11D SR MODE7 DATA=$A5: ", 0

msg_ok:        .byte "OK", $0d, 0
msg_ok_cnt:    .byte "OK @", 0
msg_fail:      .byte "FAIL @", 0
msg_press_key: .byte "PRESS ANY KEY...", $0d, 0
msg_divider:   .byte "------------------", $0d, 0
msg_all_pass:  .byte "ALL TESTS PASSED", $0d, 0
msg_some_fail: .byte "SOME TESTS FAILED", $0d, 0

