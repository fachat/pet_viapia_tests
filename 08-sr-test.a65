; ============================================================
fn_sr_m1a:    .byte "VIA.SR.M1.A"
fn_sr_m1a_end:
fn_sr_m1b:    .byte "VIA.SR.M1.B"
fn_sr_m1b_end:
fn_sr_m1c:    .byte "VIA.SR.M1.C"
fn_sr_m1c_end:
fn_sr_m1d:    .byte "VIA.SR.M1.D"
fn_sr_m1d_end:
fn_sr_m1na:   .byte "VIA.SR.M1N.A"
fn_sr_m1na_end:
fn_sr_m1nb:   .byte "VIA.SR.M1N.B"
fn_sr_m1nb_end:
fn_sr_m1nc:   .byte "VIA.SR.M1N.C"
fn_sr_m1nc_end:
fn_sr_m1nd:   .byte "VIA.SR.M1N.D"
fn_sr_m1nd_end:
fn_sr_m5a:    .byte "VIA.SR.M5.55.A"
fn_sr_m5a_end:
fn_sr_m5b:    .byte "VIA.SR.M5.55.B"
fn_sr_m5b_end:
