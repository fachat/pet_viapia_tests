
	*=$f000

#include "tb_08.i65"
#include "../hw.inc"
#include "../08-tests.i65"

reset	sei
	cld
	ldx #$ff
	txs

	; test assumes DRA and not DDRA to be active
	lda PIA1_BASE+PIA_CRA
	ora #4
	sta PIA1_BASE+PIA_CRA

	lda #$55
	jsr test_sr_mode3
	brk

irq	rti
nmi	rti

	.dsb $fffa-*
	.word nmi
	.word reset
	.word irq
