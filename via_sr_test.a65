; ============================================================
; via_sr_test.a65
; VIA Shift Register Tests
;
; Tests the 6522 VIA shift register at $E840 on the PET 4032.
; Reference timing data (produced by via_sr_test_gen.prg) must
; be present on device 8 (IEEE-488 disk drive) before running
; the mode 1 tests.
;
; Requires the userport test fixture:
;   Pin 5 (PIA1 PA7)  ->  Pin 6  (CB1) : PIA1 PA7 drives CB1 clock
;   Pin L  (VIA PA7)  <-> Pin M  (CB2) : PA7 / CB2 loopback (data)
;
; Test groups:
;
;   Group 1 - SR mode 0 (disabled): external CB1 clock
;     In mode 0 (ACR SR = 000) CB1 rising edges still shift data
;     from CB2 into SR (left-shift; new bit at bit 0).  The VIA
;     does not count bits and IFR.SR is never set.
;
;     1: Complete mode 0 sequence:
;        Setup: DDRA=$00, ACR SR=0, CB1 hi via PIA1 PA7,
;               CB2 hi output via PCR, SR=$00.
;        Steps: CB1 lo/hi cycles verify SR=$01, $03, $06;
;               8-iteration loop with alternating CB2 verifies
;               SR=$AA and IFR.SR=0 throughout.
;
;   Group 2 - SR mode 1: shift in under T2 control
;     In mode 1 (ACR SR = 001) T2 underflows clock the SR.
;     CB2 is the data input (held high via PA7 loopback).
;     After 8 bits the IFR.SR bit is set.
;     256 SR samples are compared against reference files.
;
;     2A: SR mode 1, T2 initial value = $0110  (file: VIA.SR.M1.A)
;     2B: SR mode 1, T2 initial value = $0220  (file: VIA.SR.M1.B)
;     2C: SR mode 1, T2 initial value = $0330  (file: VIA.SR.M1.C)
;     2D: SR mode 1, T2 initial value = $0440  (file: VIA.SR.M1.D)
;
;   Group 3 - SR mode 5: shift out under T2 control, SR init = $55
;     In mode 5 (ACR SR = 101) T2 underflows clock the SR.
;     CB1 is the VIA output clock; CB2 is the VIA data output.
;     Both are read back via loopback: CB1->PIA1 PA7, CB2->VIA PA7.
;     SR is armed by writing $55 to SR after setting ACR to mode 5.
;     256 combined CB1/CB2 samples are compared against reference files.
;
;     3A: SR mode 5 SR=$55, T2 initial value = $0110  (file: VIA.SR.M5.55.A)
;     3B: SR mode 5 SR=$55, T2 initial value = $0220  (file: VIA.SR.M5.55.B)
;     3C: SR mode 5 SR=$55, T2 initial value = $0330  (file: VIA.SR.M5.55.C)
;     3D: SR mode 5 SR=$55, T2 initial value = $0440  (file: VIA.SR.M5.55.D)
;
;   Group 4 - SR mode 1 (no arm read): shift in under T2 control
;     Identical to Group 2 but the SR read that arms shifting is
;     omitted.  The first shift clock therefore occurs on the first
;     T2 underflow after ACR is set to mode 1.
;
;     4A: SR mode 1 no-arm, T2 initial value = $0110  (file: VIA.SR.M1N.A)
;     4B: SR mode 1 no-arm, T2 initial value = $0220  (file: VIA.SR.M1N.B)
;     4C: SR mode 1 no-arm, T2 initial value = $0330  (file: VIA.SR.M1N.C)
;     4D: SR mode 1 no-arm, T2 initial value = $0440  (file: VIA.SR.M1N.D)
;
;   Group 5 - SR mode 5: shift out under T2 control, SR init = $AA
;     Identical to Group 3 but SR is armed by writing $AA to SR.
;
;     5A: SR mode 5 SR=$AA, T2 initial value = $0110  (file: VIA.SR.M5.AA.A)
;     5B: SR mode 5 SR=$AA, T2 initial value = $0220  (file: VIA.SR.M5.AA.B)
;     5C: SR mode 5 SR=$AA, T2 initial value = $0330  (file: VIA.SR.M5.AA.C)
;     5D: SR mode 5 SR=$AA, T2 initial value = $0440  (file: VIA.SR.M5.AA.D)
;
;   Group 6 - SR mode 3: shift in under external CB1 control
;     In mode 3 (ACR SR = 011) CB1 rising edges shift data from CB2
;     into the SR, MSB first.  After 8 edges IFR.SR is set.
;     PA7 output drives CB2 via loopback; PIA1 PA7 output drives CB1
;     via loopback.  The data byte is bit-banged in MSB-first order.
;     Each pre-shift IFR.SR=0 check and the post-shift IFR.SR=1 check
;     verify correct flag behaviour.  SR is read back and compared to
;     the original data byte; IFR.SR is verified clear after the read.
;
;     6A: SR mode 3, data = $55
;     6B: SR mode 3, data = $AA
;     6C: SR mode 3, data = $A5
;     6D: SR mode 3, data = $5A
;
;   Group 7 - SR mode 1 IFR poll: shift in under T2 control
;     Identical setup to Group 2 (SR mode 1, armed).  Instead of
;     sampling the SR into a buffer and comparing to reference data,
;     polls IFR.SR up to 256 times until it sets.  On pass the
;     iteration count (number of polls until IFR.SR set) is printed.
;     IFR.SR not set within 256 iterations is a fail.
;
;     7A: SR mode 1 IFR poll, T2 = $0110
;     7B: SR mode 1 IFR poll, T2 = $0220
;     7C: SR mode 1 IFR poll, T2 = $0330
;     7D: SR mode 1 IFR poll, T2 = $0440
;
;   Group 8 - SR mode 1 no-arm IFR poll: shift in under T2 control
;     Identical to Group 7 but the SR arm read is omitted, matching
;     the Group 4 (meas_sr_mode1_noarm) setup variant.
;
;     8A: SR mode 1 no-arm IFR poll, T2 = $0110
;     8B: SR mode 1 no-arm IFR poll, T2 = $0220
;     8C: SR mode 1 no-arm IFR poll, T2 = $0330
;     8D: SR mode 1 no-arm IFR poll, T2 = $0440
;
;   Group 9 - SR mode 5 CB1 poll, SR init = $55
;     Identical setup to Group 3 (mode 5, SR=$55, T2 driven) but
;     instead of sampling CB1/CB2 into a buffer, reconstructs the
;     shifted-out byte bit by bit by polling CB1 and sampling CB2.
;     For each of 8 bits: verifies IFR.SR is still clear; polls
;     CB1 low (up to 256 iterations); polls CB1 high (up to 256
;     iterations); samples CB2 via VIA PA7 (ASL -> carry; ROL into
;     result).  After 8 bits: verifies IFR.SR is set and result == SR_INIT.
;     On timeout FAIL_IDX = (bit_num << 4) | step (1=lo, 2=hi).
;
;     9A: SR mode 5 CB1 poll SR=$55 T2=$0110
;     9B: SR mode 5 CB1 poll SR=$55 T2=$0220
;     9C: SR mode 5 CB1 poll SR=$55 T2=$0330
;     9D: SR mode 5 CB1 poll SR=$55 T2=$0440
;
;   Group 10 - SR mode 5 CB1 poll, SR init = $AA
;     Identical to Group 9 but SR is armed with $AA.
;
;     10A: SR mode 5 CB1 poll SR=$AA T2=$0110
;     10B: SR mode 5 CB1 poll SR=$AA T2=$0220
;     10C: SR mode 5 CB1 poll SR=$AA T2=$0330
;     10D: SR mode 5 CB1 poll SR=$AA T2=$0440
;
; For Groups 2 and 4 only SR_IFR_PRE (expected: 0) is verified after
; each run; a mismatch is reported as a FAIL and the file comparison
; is skipped for that test.  SR_IFR_POST is NOT checked: the
; measurement subroutines sample IFR immediately after the shift loop
; so the flag may not yet have been raised.
;
; The measurement subroutine (meas_sr_mode1) is byte-for-byte
; identical to the one in via_sr_test_gen.a65, ensuring that the
; measured values match the pre-recorded reference data.
;
; Target   : Commodore PET 4032
; Assembler: xa65  (command: xa -W -XMASM)
; Load     : LOAD then RUN  -- or autostart in VICE
; ============================================================

; ============================================================
; Hardware addresses
; ============================================================
VIA_BASE = $E840            ; VIA (6522) base address

; VIA register offsets from VIA_BASE
VIA_T1CL = $04              ; T1 counter low  (read: clears IFR6)
VIA_T1LL = $06              ; T1 latch low    (read/write: latch only)
VIA_T1LH = $07              ; T1 latch high   (write: clears IFR6; read: latch)
VIA_T2CL = $08              ; T2 counter low  (write: latch; read: counter, clears IFR5)
VIA_T2CH = $09              ; T2 counter high (write: loads T2CL from latch, starts)
VIA_SR   = $0A              ; Shift register
VIA_ACR  = $0B              ; Auxiliary control register
VIA_PCR  = $0C              ; Peripheral control register
VIA_IFR  = $0D              ; Interrupt flag register
VIA_IER  = $0E              ; Interrupt enable register
VIA_DDRA = $03              ; Port A data direction register (1=output)
VIA_ORA_NH = $0F            ; Port A data, no handshake (no IFR side-effect)

; PIA1
PIA1_BASE = $E810           ; PIA1 base address
PIA_ORA   = 0               ; Port A / DDRA (selected by CRA bit 2)
PIA_CRA   = 1               ; Control register A (bit 2: 0=DDRA, 1=data)

; ACR SR mode (bits 4:2)
ACR_SR_MASK  = $1C          ; mask for SR mode bits
ACR_SR_NMASK = $E3          ; inverse mask: clears SR mode bits 4:2
ACR_SR_OFF   = $00          ; 000 -> SR disabled
ACR_SR_IT2   = $04          ; 001 -> shift in under T2 control
ACR_SR_IE1   = $0C          ; 011 -> shift in under external CB1 control
ACR_SR_OT2   = $14          ; 101 -> shift out under T2 control

; IFR / IER bit masks
IFR_T1 = $40                ; bit 6 = T1 timeout
IFR_T2 = $20                ; bit 5 = T2 timeout
IFR_SR = $04                ; bit 2 = SR complete

; VIA PCR CB2 mode constants (bits 7:5):
;   111 = manual output high; 110 = manual output low
PCR_CB2_HI    = $E0         ; CB2 manual output high (bits 7:5 = 111)
PCR_CB2_LO    = $C0         ; CB2 manual output low  (bits 7:5 = 110)
PCR_CB2_NMASK = $1F         ; inverse mask: clears CB2 mode bits 7:5

; CBM KERNAL
CHROUT = $FFD2
GETIN  = $FFE4

; ============================================================
; Zero-page ($02-$13 - safe for standalone ML on PET)
; ============================================================
STRPTR         = $02        ; 2-byte string pointer for print_str
PASS_CNT       = $04        ; running pass counter
FAIL_CNT       = $05        ; running fail counter
FNPTR          = $06        ; 2-byte pointer to current filename ($06-$07)
FNLEN          = $08        ; length of current filename
ACR_SAVE       = $09        ; saved VIA ACR value
IER_SAVE       = $0A        ; saved VIA IER value
TMP            = $0B        ; scratch byte
MEAS_ACR       = $0C        ; measurement ACR, saved/restored around KERNAL calls
FAIL_IDX       = $0D        ; index of first mismatch byte from compare_file
SR_T2_LO       = $0E        ; T2 initial value low byte (for meas_sr_mode1)
SR_T2_HI       = $0F        ; T2 initial value high byte (for meas_sr_mode1)
FAIL_STEP      = $10        ; step number where mode 0 test last failed
PCR_SAVE       = $11        ; saved VIA PCR (mode 0 test save/restore)
PIA1_DDRA_SAVE = $12        ; saved PIA1 DDRA (mode 0 test save/restore)
PIA1_ORA_SAVE  = $13        ; saved PIA1 ORA data (mode 0 test save/restore)
SR_INIT        = $14        ; initial value written to SR in meas_sr_mode5 before sampling
SR_IFR_PRE     = $15        ; IFR & IFR_SR sampled before arming SR (expected: 0)
SR_IFR_POST    = $16        ; IFR & IFR_SR sampled after sample loop (expected: IFR_SR)
SR_M3_DATA     = $17        ; original data byte passed to test_sr_mode3
SR_M3_SHIFT    = $18        ; working copy of data, shifted left each iteration
SR_IFR_COUNT   = $19        ; iteration count from test_sr_mode1_ifr / _noarm_ifr
SR_M5_RESULT   = $1A        ; reconstructed byte in test_sr_mode5_cb1
SR_M5_BITNO    = $1B        ; current bit number (1..8) in test_sr_mode5_cb1

; ============================================================
; Memory buffers
; ============================================================
MEAS_BUF = $7E00            ; measurement result buffer (256 bytes, $7E00-$7EFF)
; NOTE: REF_BUF must equal MEAS_BUF in via_sr_test_gen.a65 ($7F00) so that
; the PRG file saved by via_sr_test_gen loads at REF_BUF without address override.
REF_BUF  = $7F00            ; reference data buffer    (256 bytes, $7F00-$7FFF)

; ============================================================
; .PRG file header
; ============================================================
* = $0401 - 2
        .word $0401

* = $0401
        .word basic_end
        .word 10
        .byte $9e
        .byte "1037"
        .byte 0
basic_end:
        .word 0

; ============================================================
; Machine code entry point  ($040D = 1037 decimal)
;
; SYS 1037 executes the 3-byte JMP at $040D, which jumps over
; the included measurement subroutines to main.  Placing the
; measurement code at $0410 (immediately after the JMP, and at
; the same address in via_sr_test_gen.prg) guarantees identical
; branch-target page alignment and thus cycle-accurate timing
; reproducibility between the generator and test runs.
; ============================================================
* = $040D
        jmp main            ; skip measurement code; land at main below

.include "via_sr_meas.inc"  ; meas_sr_mode1 subroutine assembled at $0410

; ============================================================
; Main entry point
; ============================================================
main:
        lda #0
        sta PASS_CNT
        sta FAIL_CNT
        sta FAIL_STEP

        lda #$93
        jsr CHROUT

        lda #<msg_banner
        ldx #>msg_banner
        jsr print_str

        ; save VIA state and disable T1/T2/SR interrupts
        sei
        lda VIA_BASE+VIA_ACR
        sta ACR_SAVE
        lda VIA_BASE+VIA_IER
        sta IER_SAVE
        lda #IFR_T1|IFR_T2|IFR_SR
        sta VIA_BASE+VIA_IER
        cli

        ; --------------------------------------------------------
        ; Group 1 - SR mode 0 (external CB1 clock)
        ; --------------------------------------------------------
        lda #<msg_grp1
        ldx #>msg_grp1
        jsr print_str

        lda #<msg_t1
        ldx #>msg_t1
        jsr print_str
        jsr test_sr_mode0
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 2 - SR mode 1 (shift in under T2 control)
        ;
        ; Ensure PIA1 PA7 is an INPUT before mode 1 measurements.
        ; In SR mode 1 the VIA drives CB1 as an output clock; if
        ; PIA1 PA7 were still an output it would conflict on CB1.
        ; --------------------------------------------------------
        lda #<msg_grp2
        ldx #>msg_grp2
        jsr print_str

        sei
        lda PIA1_BASE+PIA_CRA
        pha                         ; save CRA
        and #$FB                    ; select DDRA (bit 2 = 0)
        sta PIA1_BASE+PIA_CRA
        lda PIA1_BASE+PIA_ORA       ; read DDRA
        and #$7F                    ; clear PA7 -> PA7 = input
        sta PIA1_BASE+PIA_ORA
        pla
        sta PIA1_BASE+PIA_CRA       ; restore CRA
        cli

        lda #<msg_t2a
        ldx #>msg_t2a
        jsr print_str
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode1
        jsr check_ifr_pre_post      ; verify IFR_PRE=0
        bne t2a_done
        lda #<fn_sr_m1a
        ldx #>fn_sr_m1a
        ldy #fn_sr_m1a_end - fn_sr_m1a
        jsr compare_file
t2a_done:
        jsr print_result

        lda #<msg_t2b
        ldx #>msg_t2b
        jsr print_str
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode1
        jsr check_ifr_pre_post
        bne t2b_done
        lda #<fn_sr_m1b
        ldx #>fn_sr_m1b
        ldy #fn_sr_m1b_end - fn_sr_m1b
        jsr compare_file
t2b_done:
        jsr print_result

        lda #<msg_t2c
        ldx #>msg_t2c
        jsr print_str
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode1
        jsr check_ifr_pre_post
        bne t2c_done
        lda #<fn_sr_m1c
        ldx #>fn_sr_m1c
        ldy #fn_sr_m1c_end - fn_sr_m1c
        jsr compare_file
t2c_done:
        jsr print_result

        lda #<msg_t2d
        ldx #>msg_t2d
        jsr print_str
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode1
        jsr check_ifr_pre_post
        bne t2d_done
        lda #<fn_sr_m1d
        ldx #>fn_sr_m1d
        ldy #fn_sr_m1d_end - fn_sr_m1d
        jsr compare_file
t2d_done:
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 3 - SR mode 5 (shift out under T2 control), SR init = $55
        ;
        ; PIA1 PA7 remains an input (VIA drives CB1 as output clock).
        ; meas_sr_mode5 sets VIA DDRA=$00 internally so VIA PA7 is
        ; an input to read CB2 data via the loopback cable.
        ; --------------------------------------------------------
        lda #<msg_grp3
        ldx #>msg_grp3
        jsr print_str

        lda #<msg_t3a
        ldx #>msg_t3a
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #<fn_sr_m5a
        ldx #>fn_sr_m5a
        ldy #fn_sr_m5a_end - fn_sr_m5a
        jsr compare_file
        jsr print_result

        lda #<msg_t3b
        ldx #>msg_t3b
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #<fn_sr_m5b
        ldx #>fn_sr_m5b
        ldy #fn_sr_m5b_end - fn_sr_m5b
        jsr compare_file
        jsr print_result

        lda #<msg_t3c
        ldx #>msg_t3c
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #<fn_sr_m5c
        ldx #>fn_sr_m5c
        ldy #fn_sr_m5c_end - fn_sr_m5c
        jsr compare_file
        jsr print_result

        lda #<msg_t3d
        ldx #>msg_t3d
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #<fn_sr_m5d
        ldx #>fn_sr_m5d
        ldy #fn_sr_m5d_end - fn_sr_m5d
        jsr compare_file
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 5 - SR mode 5 (shift out under T2 control), SR init = $AA
        ; --------------------------------------------------------
        lda #<msg_grp5
        ldx #>msg_grp5
        jsr print_str

        lda #<msg_t5a
        ldx #>msg_t5a
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #<fn_sr_m5aaa
        ldx #>fn_sr_m5aaa
        ldy #fn_sr_m5aaa_end - fn_sr_m5aaa
        jsr compare_file
        jsr print_result

        lda #<msg_t5b
        ldx #>msg_t5b
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #<fn_sr_m5aab
        ldx #>fn_sr_m5aab
        ldy #fn_sr_m5aab_end - fn_sr_m5aab
        jsr compare_file
        jsr print_result

        lda #<msg_t5c
        ldx #>msg_t5c
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #<fn_sr_m5aac
        ldx #>fn_sr_m5aac
        ldy #fn_sr_m5aac_end - fn_sr_m5aac
        jsr compare_file
        jsr print_result

        lda #<msg_t5d
        ldx #>msg_t5d
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode5
        lda #<fn_sr_m5aad
        ldx #>fn_sr_m5aad
        ldy #fn_sr_m5aad_end - fn_sr_m5aad
        jsr compare_file
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 4 - SR mode 1, no arm read (shift in under T2 control)
        ;
        ; Identical to Group 2 but the SR read that arms shifting is
        ; omitted; the first shift clock occurs on the first T2
        ; underflow after ACR is set to mode 1.
        ; PIA1 PA7 remains an input (already set for Group 2/3).
        ; --------------------------------------------------------
        lda #<msg_grp4
        ldx #>msg_grp4
        jsr print_str

        lda #<msg_t4a
        ldx #>msg_t4a
        jsr print_str
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        jsr check_ifr_pre_post
        bne t4a_done
        lda #<fn_sr_m1na
        ldx #>fn_sr_m1na
        ldy #fn_sr_m1na_end - fn_sr_m1na
        jsr compare_file
t4a_done:
        jsr print_result

        lda #<msg_t4b
        ldx #>msg_t4b
        jsr print_str
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        jsr check_ifr_pre_post
        bne t4b_done
        lda #<fn_sr_m1nb
        ldx #>fn_sr_m1nb
        ldy #fn_sr_m1nb_end - fn_sr_m1nb
        jsr compare_file
t4b_done:
        jsr print_result

        lda #<msg_t4c
        ldx #>msg_t4c
        jsr print_str
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        jsr check_ifr_pre_post
        bne t4c_done
        lda #<fn_sr_m1nc
        ldx #>fn_sr_m1nc
        ldy #fn_sr_m1nc_end - fn_sr_m1nc
        jsr compare_file
t4c_done:
        jsr print_result

        lda #<msg_t4d
        ldx #>msg_t4d
        jsr print_str
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr meas_sr_mode1_noarm
        jsr check_ifr_pre_post
        bne t4d_done
        lda #<fn_sr_m1nd
        ldx #>fn_sr_m1nd
        ldy #fn_sr_m1nd_end - fn_sr_m1nd
        jsr compare_file
t4d_done:
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 6 - SR mode 3 (shift in under external CB1 control)
        ;
        ; CB1 is the external clock input (driven via PIA1 PA7 loopback).
        ; CB2 is the data input (driven via VIA PA7 loopback).
        ; PA7 = output (DDRA=$80); PIA1 PA7 = output, drives CB1 clock.
        ; Data bytes $55, $AA, $A5, $5A are shifted in MSB-first.
        ; --------------------------------------------------------
        lda #<msg_grp6
        ldx #>msg_grp6
        jsr print_str

        lda #<msg_t6a
        ldx #>msg_t6a
        jsr print_str
        lda #$55
        jsr test_sr_mode3
        jsr print_result

        lda #<msg_t6b
        ldx #>msg_t6b
        jsr print_str
        lda #$aa
        jsr test_sr_mode3
        jsr print_result

        lda #<msg_t6c
        ldx #>msg_t6c
        jsr print_str
        lda #$a5
        jsr test_sr_mode3
        jsr print_result

        lda #<msg_t6d
        ldx #>msg_t6d
        jsr print_str
        lda #$5a
        jsr test_sr_mode3
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 7 - SR mode 1 IFR poll (shift in under T2 control)
        ;
        ; Same setup as Group 2 (armed mode 1) but instead of sampling
        ; SR into a buffer, polls IFR.SR up to 256 iterations until it
        ; sets.  The iteration count is printed on pass.
        ; PIA1 PA7 is an input (restored by test_sr_mode3 via sm3_restore).
        ; --------------------------------------------------------
        lda #<msg_grp7
        ldx #>msg_grp7
        jsr print_str

        lda #<msg_t7a
        ldx #>msg_t7a
        jsr print_str
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr test_sr_mode1_ifr
        jsr print_result_cnt

        lda #<msg_t7b
        ldx #>msg_t7b
        jsr print_str
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr test_sr_mode1_ifr
        jsr print_result_cnt

        lda #<msg_t7c
        ldx #>msg_t7c
        jsr print_str
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr test_sr_mode1_ifr
        jsr print_result_cnt

        lda #<msg_t7d
        ldx #>msg_t7d
        jsr print_str
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr test_sr_mode1_ifr
        jsr print_result_cnt

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 8 - SR mode 1 no-arm IFR poll (shift in under T2 control)
        ;
        ; Same as Group 7 but the SR arm read is omitted, matching the
        ; Group 4 (meas_sr_mode1_noarm) setup variant.
        ; --------------------------------------------------------
        lda #<msg_grp8
        ldx #>msg_grp8
        jsr print_str

        lda #<msg_t8a
        ldx #>msg_t8a
        jsr print_str
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr test_sr_mode1_noarm_ifr
        jsr print_result

        lda #<msg_t8b
        ldx #>msg_t8b
        jsr print_str
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr test_sr_mode1_noarm_ifr
        jsr print_result

        lda #<msg_t8c
        ldx #>msg_t8c
        jsr print_str
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr test_sr_mode1_noarm_ifr
        jsr print_result

        lda #<msg_t8d
        ldx #>msg_t8d
        jsr print_str
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr test_sr_mode1_noarm_ifr
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 9 - SR mode 5 CB1 poll (shift out under T2 control), SR init = $55
        ;
        ; Same setup as Group 3 (mode 5, SR=$55) but instead of sampling
        ; CB1/CB2 into MEAS_BUF, reconstructs the shifted-out byte by
        ; polling CB1 low/high for each of 8 bits and sampling CB2.
        ; PIA1 PA7 must be an input (already set; VIA drives CB1).
        ; --------------------------------------------------------
        lda #<msg_grp9
        ldx #>msg_grp9
        jsr print_str

        lda #<msg_t9a
        ldx #>msg_t9a
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr test_sr_mode5_cb1
        jsr print_result

        lda #<msg_t9b
        ldx #>msg_t9b
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr test_sr_mode5_cb1
        jsr print_result

        lda #<msg_t9c
        ldx #>msg_t9c
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr test_sr_mode5_cb1
        jsr print_result

        lda #<msg_t9d
        ldx #>msg_t9d
        jsr print_str
        lda #$55
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr test_sr_mode5_cb1
        jsr print_result

        jsr wait_key

        ; --------------------------------------------------------
        ; Group 10 - SR mode 5 CB1 poll (shift out under T2 control), SR init = $AA
        ;
        ; Identical to Group 9 but SR is armed with $AA.
        ; --------------------------------------------------------
        lda #<msg_grp10
        ldx #>msg_grp10
        jsr print_str

        lda #<msg_t10a
        ldx #>msg_t10a
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$10
        sta SR_T2_LO
        lda #$01
        sta SR_T2_HI
        jsr test_sr_mode5_cb1
        jsr print_result

        lda #<msg_t10b
        ldx #>msg_t10b
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$20
        sta SR_T2_LO
        lda #$02
        sta SR_T2_HI
        jsr test_sr_mode5_cb1
        jsr print_result

        lda #<msg_t10c
        ldx #>msg_t10c
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$30
        sta SR_T2_LO
        lda #$03
        sta SR_T2_HI
        jsr test_sr_mode5_cb1
        jsr print_result

        lda #<msg_t10d
        ldx #>msg_t10d
        jsr print_str
        lda #$aa
        sta SR_INIT
        lda #$40
        sta SR_T2_LO
        lda #$04
        sta SR_T2_HI
        jsr test_sr_mode5_cb1
        jsr print_result

        ; --------------------------------------------------------
        ; Restore VIA state and print summary
        ; --------------------------------------------------------
        sei
        lda ACR_SAVE
        sta VIA_BASE+VIA_ACR
        lda IER_SAVE
        ora #$80
        sta VIA_BASE+VIA_IER
        cli

        lda #<msg_divider
        ldx #>msg_divider
        jsr print_str

        lda FAIL_CNT
        bne main_fail
        lda #<msg_all_pass
        ldx #>msg_all_pass
        jsr print_str
        jmp main_done
main_fail:
        lda #<msg_some_fail
        ldx #>msg_some_fail
        jsr print_str
main_done:
        rts

; ============================================================
; Subroutine: test_sr_mode0
;
; Tests SR mode 0 (ACR SR = 000, disabled) behavior:
; CB1 rising edges shift data from CB2 into SR (left-shift;
; new data bit enters at bit 0).  The VIA does not count bits
; and IFR.SR is never set.
;
; Hardware connections required:
;   PIA1 PA7 output -> CB1 (Pin 5 -> Pin 6, loopback)
;   VIA PA7 input   <-> CB2 (Pin L <-> Pin M, loopback)
;   (DDRA=$00 keeps all VIA PA as inputs to avoid CB2 conflict)
;
; Sequence:
;   Setup: DDRA=0, ACR SR=0, CB1=hi, CB2=hi output (PCR), SR=0
;   Step 1: CB1 lo       -> read SR, expect $00
;   Step 2: CB1 hi       -> read SR, expect $01
;   Step 3: CB1 lo       -> read SR, expect $01
;   Step 4: CB1 hi       -> read SR, expect $03
;   Step 5: CB2=lo, CB1 lo -> read SR, expect $03
;   Step 6: CB1 hi       -> read SR, expect $06
;   Loop (8x): CB1 lo, invert CB2, CB1 hi -> IFR.SR must be 0
;   Final: read SR, expect $AA
;
; Returns: A = 0 (pass), A = 1 (fail)
; FAIL_STEP = step number on failure (1-8; 7 = IFR.SR set in loop)
; Clobbers: A, X
; ============================================================
test_sr_mode0:
        sei

        ; Save PCR (restored at cleanup)
        lda VIA_BASE+VIA_PCR
        sta PCR_SAVE

        ; Configure PIA1 PA7 as output; save original state; drive CB1 high
        lda PIA1_BASE+PIA_CRA
        pha                         ; save CRA on stack
        and #$FB                    ; select DDRA (CRA bit 2 = 0)
        sta PIA1_BASE+PIA_CRA
        lda PIA1_BASE+PIA_ORA       ; read DDRA
        sta PIA1_DDRA_SAVE          ; save DDRA
        ora #$80                    ; set PA7 = output
        sta PIA1_BASE+PIA_ORA
        pla                         ; restore CRA
        sta PIA1_BASE+PIA_CRA       ; re-select data register
        lda PIA1_BASE+PIA_ORA       ; read ORA data
        sta PIA1_ORA_SAVE           ; save ORA data
        ora #$80                    ; PA7 = 1 -> CB1 high
        sta PIA1_BASE+PIA_ORA

        ; VIA DDRA = $00: all PA = input (avoids CB2 bus conflict)
        lda #0
        sta VIA_BASE+VIA_DDRA

        ; ACR SR = mode 0 (disabled)
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        sta VIA_BASE+VIA_ACR

        ; PCR CB2 = manual high output (bits 7:5 = 111)
        lda VIA_BASE+VIA_PCR
        and #PCR_CB2_NMASK
        ora #PCR_CB2_HI
        sta VIA_BASE+VIA_PCR

        ; Write 0 to SR
        lda #0
        sta VIA_BASE+VIA_SR

        ; ---- Step 1: CB1 lo -> SR = $00 ----
        lda #1
        sta FAIL_STEP
        lda PIA1_BASE+PIA_ORA
        and #$7F                    ; PA7 = 0 -> CB1 low (no shift)
        sta PIA1_BASE+PIA_ORA
        lda VIA_BASE+VIA_SR
        bne sm0_jmp_fail            ; expect $00

        ; ---- Step 2: CB1 hi -> SR = $01 ----
        lda #2
        sta FAIL_STEP
        lda PIA1_BASE+PIA_ORA
        ora #$80                    ; PA7 = 1 -> CB1 high (rising edge -> shift)
        sta PIA1_BASE+PIA_ORA
        lda VIA_BASE+VIA_SR
        cmp #$01
        bne sm0_jmp_fail

        ; ---- Step 3: CB1 lo -> SR still $01 ----
        lda #3
        sta FAIL_STEP
        lda PIA1_BASE+PIA_ORA
        and #$7F
        sta PIA1_BASE+PIA_ORA
        lda VIA_BASE+VIA_SR
        cmp #$01
        bne sm0_jmp_fail

        ; ---- Step 4: CB1 hi -> SR = $03 ----
        lda #4
        sta FAIL_STEP
        lda PIA1_BASE+PIA_ORA
        ora #$80
        sta PIA1_BASE+PIA_ORA
        lda VIA_BASE+VIA_SR
        cmp #$03
        bne sm0_jmp_fail
        jmp sm0_step5_start     ; step 4 passed: skip over the trampoline

        ; sm0_jmp_fail: trampoline used by early steps 1-4 whose branches
        ; cannot reach sm0_fail directly (> 127 bytes away).
sm0_jmp_fail:
        jmp sm0_fail

        ; ---- Set CB2 low; Step 5: CB1 lo -> SR still $03 ----
sm0_step5_start:
        lda VIA_BASE+VIA_PCR
        and #PCR_CB2_NMASK
        ora #PCR_CB2_LO             ; CB2 manual low (bits 7:5 = 110)
        sta VIA_BASE+VIA_PCR
        lda #5
        sta FAIL_STEP
        lda PIA1_BASE+PIA_ORA
        and #$7F
        sta PIA1_BASE+PIA_ORA
        lda VIA_BASE+VIA_SR
        cmp #$03
        bne sm0_fail

        ; ---- Step 6: CB1 hi -> SR = $06 ----
        lda #6
        sta FAIL_STEP
        lda PIA1_BASE+PIA_ORA
        ora #$80
        sta PIA1_BASE+PIA_ORA
        lda VIA_BASE+VIA_SR
        cmp #$06
        bne sm0_fail

        ; ---- Loop 8 times: CB1 lo, invert CB2, CB1 hi, IFR.SR=0 ----
        ; CB2 is currently low (PCR bits 7:5 = 110).
        ; Each iteration: invert bit 5 -> toggles between 110 (low) and 111 (high).
        ldx #8
sm0_loop:
        ; CB1 low
        lda PIA1_BASE+PIA_ORA
        and #$7F
        sta PIA1_BASE+PIA_ORA
        ; Invert CB2 output (toggle PCR bit 5: 110 <-> 111)
        lda VIA_BASE+VIA_PCR
        eor #$20
        sta VIA_BASE+VIA_PCR
        ; CB1 high (rising edge -> shift)
        lda PIA1_BASE+PIA_ORA
        ora #$80
        sta PIA1_BASE+PIA_ORA
        ; Verify IFR.SR is clear (mode 0 must not count bits)
        lda #7
        sta FAIL_STEP
        lda VIA_BASE+VIA_IFR
        and #IFR_SR
        bne sm0_fail
        dex
        bne sm0_loop

        ; ---- Verify SR = $AA ----
        lda #8
        sta FAIL_STEP
        lda VIA_BASE+VIA_SR         ; read SR (also clears IFR.SR if set)
        cmp #$AA
        bne sm0_fail

        ; PASS
        jsr sm0_restore
        cli
        lda #0
        rts

sm0_fail:
        jsr sm0_restore
        cli
        lda #1
        rts

; ============================================================
; Subroutine: sm0_restore
;
; Restores PCR, PIA1 ORA data, and PIA1 DDRA after test_sr_mode0.
; ============================================================
sm0_restore:
        ; Restore VIA PCR
        lda PCR_SAVE
        sta VIA_BASE+VIA_PCR
        ; Restore PIA1 ORA data (CRA bit 2 = 1 -> data register)
        lda PIA1_ORA_SAVE
        sta PIA1_BASE+PIA_ORA
        ; Restore PIA1 DDRA
        lda PIA1_BASE+PIA_CRA
        pha
        and #$FB                    ; select DDRA
        sta PIA1_BASE+PIA_CRA
        lda PIA1_DDRA_SAVE
        sta PIA1_BASE+PIA_ORA       ; write DDRA
        pla
        sta PIA1_BASE+PIA_CRA       ; restore CRA
        rts

; ============================================================
; Subroutine: test_sr_mode3
;
; Tests SR mode 3 (shift in under external CB1 control).
; CB1 is the external clock input, driven via PIA1 PA7 loopback.
; CB2 is the data input, driven via VIA PA7 (DDRA=$80) loopback.
; The 8 data bits are shifted in MSB-first by bit-banging CB1/CB2.
;
; Hardware connections required:
;   PIA1 PA7 output -> CB1 (Pin 5 -> Pin 6, loopback)
;   VIA PA7  output -> CB2 (Pin L -> Pin M, loopback)
;
; Sequence:
;   Setup: SR disabled, PCR CB2=input, PIA1 PA7=output CB1=hi,
;          DDRA=$80 (PA7=out), PA7=1 (CB2=hi), SR=0, IFR.SR cleared,
;          SR read (reset bit counter), ACR SR=mode 3.
;   For each of 8 bits (MSB first):
;     verify IFR.SR is clear
;     CB1 low
;     CB2 = bit 7 of data (via PA7 loopback)
;     ASL data
;     CB1 high (rising edge shifts CB2 into SR)
;     CB2 high (restore idle)
;   After 8 bits:
;     verify IFR.SR is set
;     read SR and compare to original data
;     verify IFR.SR is now clear (cleared by SR read)
;
; Entry: A = data byte to shift in
; Returns: A = 0 (pass), A = 1 (fail)
; FAIL_STEP / FAIL_IDX on failure:
;   1 = IFR.SR unexpectedly set inside shift loop
;   2 = IFR.SR not set after 8 bits
;   3 = SR value mismatch
;   4 = IFR.SR not cleared by SR read
; Clobbers: A, X
; ============================================================
test_sr_mode3:
        sei

        ; Save original data and working copy
        sta SR_M3_DATA
        sta SR_M3_SHIFT

        ; Save PCR
        lda VIA_BASE+VIA_PCR
        sta PCR_SAVE

        ; Disable SR (mode 0) and write 0 to SR first, before any pin changes
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        sta VIA_BASE+VIA_ACR
        lda #0
        sta VIA_BASE+VIA_SR

        ; Configure PIA1 PA7 as output; save original DDRA and ORA; CB1 high
        lda PIA1_BASE+PIA_CRA
        pha                         ; save CRA on stack
        and #$FB                    ; select DDRA (CRA bit 2 = 0)
        sta PIA1_BASE+PIA_CRA
        lda PIA1_BASE+PIA_ORA       ; read DDRA
        sta PIA1_DDRA_SAVE          ; save DDRA
        ora #$80                    ; set PA7 = output
        sta PIA1_BASE+PIA_ORA
        pla                         ; restore CRA
        sta PIA1_BASE+PIA_CRA       ; re-select data register
        lda PIA1_BASE+PIA_ORA       ; read ORA data
        sta PIA1_ORA_SAVE           ; save ORA data
        ora #$80                    ; PA7 = 1 -> CB1 high
        sta PIA1_BASE+PIA_ORA

        ; Set CB2 as input (PCR bits 7:5 = 000) before driving PA7 as output
        lda VIA_BASE+VIA_PCR
        and #$1F                    ; clear CB2 mode bits 7:5
        sta VIA_BASE+VIA_PCR

        ; Set VIA PA7 as output, drive CB2 high via loopback
        lda #$80
        sta VIA_BASE+VIA_DDRA       ; PA7 = output
        sta VIA_BASE+VIA_ORA_NH     ; PA7 = 1 -> CB2 = high

        ; Clear IFR.SR explicitly before setting mode 3
        lda #IFR_SR
        sta VIA_BASE+VIA_IFR

        ; Set SR to mode 3: shift in under external CB1 control
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_IE1
        sta VIA_BASE+VIA_ACR

	; reset the SR bit counter to 8, so bits are shifted in
	; note: needs to be done after setting the mode
	lda VIA_BASE+VIA_SR

        ; Shift 8 bits in, MSB first
        ldx #8
sm3_loop:
        ; Verify IFR.SR is clear before this bit shift
        lda #1
        sta FAIL_STEP
        lda VIA_BASE+VIA_IFR
        and #IFR_SR
        bne sm3_jmp_fail

        ; CB1 low
        lda PIA1_BASE+PIA_ORA
        and #$7F                    ; PA7 = 0 -> CB1 low
        sta PIA1_BASE+PIA_ORA

        ; CB2 = bit 7 of SR_M3_SHIFT (0 -> PA7=0, 1 -> PA7=$80)
        lda SR_M3_SHIFT
        and #$80
        sta VIA_BASE+VIA_ORA_NH     ; drive PA7 = data bit 7 -> CB2 via loopback

        ; Shift working copy left (next bit becomes bit 7)
        asl SR_M3_SHIFT

        ; CB1 high (rising edge -> VIA shifts CB2 into SR)
        lda PIA1_BASE+PIA_ORA
        ora #$80                    ; PA7 = 1 -> CB1 high
        sta PIA1_BASE+PIA_ORA

        ; CB2 high (restore to idle)
        lda #$80
        sta VIA_BASE+VIA_ORA_NH

        dex
        bne sm3_loop

        ; ---- Verify IFR.SR is set after 8 bits ----
        lda #2
        sta FAIL_STEP
        lda VIA_BASE+VIA_IFR
        and #IFR_SR
        beq sm3_fail

        ; ---- Read SR and compare to original data ----
        lda #3
        sta FAIL_STEP
        lda VIA_BASE+VIA_SR         ; read SR (also clears IFR.SR)
        cmp SR_M3_DATA
        bne sm3_fail

        ; ---- Verify IFR.SR is now clear (cleared by SR read) ----
        lda #4
        sta FAIL_STEP
        lda VIA_BASE+VIA_IFR
        and #IFR_SR
        bne sm3_fail

        ; PASS
        jsr sm3_restore
        cli
        lda #0
        rts

sm3_jmp_fail:
        jmp sm3_fail

sm3_fail:
        lda FAIL_STEP
        sta FAIL_IDX
        jsr sm3_restore
        cli
        lda #1
        rts

; ============================================================
; Subroutine: sm3_restore
;
; Restores PCR, PIA1 ORA data, PIA1 DDRA, and VIA DDRA after
; test_sr_mode3.
; ============================================================
sm3_restore:
        ; Disable SR
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_OFF
        sta VIA_BASE+VIA_ACR
        ; Restore VIA PCR
        lda PCR_SAVE
        sta VIA_BASE+VIA_PCR
        ; Restore PIA1 ORA data
        lda PIA1_ORA_SAVE
        sta PIA1_BASE+PIA_ORA
        ; Restore PIA1 DDRA
        lda PIA1_BASE+PIA_CRA
        pha
        and #$FB                    ; select DDRA
        sta PIA1_BASE+PIA_CRA
        lda PIA1_DDRA_SAVE
        sta PIA1_BASE+PIA_ORA       ; write DDRA
        pla
        sta PIA1_BASE+PIA_CRA       ; restore CRA
        rts

; ============================================================
; Subroutine: check_ifr_pre_post
;
; Verifies that SR_IFR_PRE == 0.
; SR_IFR_POST is NOT checked: meas_sr_mode1 and meas_sr_mode1_noarm
; sample IFR immediately after the shift loop so the flag may not yet
; be set.
; SR_IFR_PRE is populated by meas_sr_mode1 / meas_sr_mode1_noarm.
;
; Returns: A = 0 (pass), A = 1 (fail)
; On fail: FAIL_IDX = $F1 (IFR_PRE != 0)
; Clobbers: A
; ============================================================
check_ifr_pre_post:
        lda SR_IFR_PRE
        beq cfpp_pass
        lda #$F1
        sta FAIL_IDX
        lda #1
        rts
cfpp_pass:
        lda #0
        rts

; ============================================================
; Subroutine: test_sr_mode1_ifr
;
; Sets up SR mode 1 (shift in under T2 control, armed), then
; polls IFR.SR for up to 256 iterations until it sets.
; T2 initial value must be set in SR_T2_LO / SR_T2_HI before calling.
; PIA1 PA7 must be an input (VIA drives CB1 as output clock).
;
; On pass:   A = 0, SR_IFR_COUNT = poll iteration count (0..255).
;   Count is the X value when IFR.SR was detected set.
; On fail:   A = 1, FAIL_IDX = $FF (IFR.SR never set).
; Clobbers: A, X
; ============================================================
test_sr_mode1_ifr:
        sei
        ; Disable SR (mode 0) and clear SR
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        sta VIA_BASE+VIA_ACR
        lda #0
        sta VIA_BASE+VIA_SR
        ; Set CB2 as input (PCR bits 7:5 = 000)
        lda VIA_BASE+VIA_PCR
        and #$1F
        sta VIA_BASE+VIA_PCR
        ; Set PA7 as output, drive high (CB2 = high via loopback)
        lda #$80
        sta VIA_BASE+VIA_DDRA
        sta VIA_BASE+VIA_ORA_NH
        ; Load T2 and start counting
        lda SR_T2_LO
        sta VIA_BASE+VIA_T2CL
        lda SR_T2_HI
        sta VIA_BASE+VIA_T2CH
        ; Set SR to mode 1
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_IT2
        sta VIA_BASE+VIA_ACR
        ; Arm SR by reading it
        lda VIA_BASE+VIA_SR
        ; Poll IFR.SR up to 256 iterations
        ldx #0
tsm1i_loop:
        lda VIA_BASE+VIA_IFR
        and #IFR_SR
        bne tsm1i_pass          ; IFR.SR set -> pass
        inx
        bne tsm1i_loop          ; not wrapped yet -> continue
        ; Timeout: IFR.SR still clear after 256 iterations
        lda #$FF
        sta FAIL_IDX
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_OFF
        sta VIA_BASE+VIA_ACR
        cli
        lda #1
        rts
tsm1i_pass:
        stx SR_IFR_COUNT
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_OFF
        sta VIA_BASE+VIA_ACR
        cli
        lda #0
        rts

; ============================================================
; Subroutine: test_sr_mode1_noarm_ifr
;
; Tests that SR mode 1 without the arm read does NOT raise IFR.SR.
; The expected outcome is timeout (IFR.SR never set after 256 polls).
; If IFR.SR is detected on any iteration that is a failure; FAIL_IDX
; holds the iteration number (0..255) at which IFR.SR was detected.
;
; On pass:   A = 0 (timeout reached, IFR.SR never set).
; On fail:   A = 1, FAIL_IDX = iteration number when IFR.SR was detected.
; Clobbers: A, X
; ============================================================
test_sr_mode1_noarm_ifr:
        sei
        ; Disable SR (mode 0) and clear SR
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        sta VIA_BASE+VIA_ACR
        lda #0
        sta VIA_BASE+VIA_SR
        ; Set CB2 as input (PCR bits 7:5 = 000)
        lda VIA_BASE+VIA_PCR
        and #$1F
        sta VIA_BASE+VIA_PCR
        ; Set PA7 as output, drive high (CB2 = high via loopback)
        lda #$80
        sta VIA_BASE+VIA_DDRA
        sta VIA_BASE+VIA_ORA_NH
        ; Load T2 and start counting
        lda SR_T2_LO
        sta VIA_BASE+VIA_T2CL
        lda SR_T2_HI
        sta VIA_BASE+VIA_T2CH
        ; Set SR to mode 1 (no arm read)
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_IT2
        sta VIA_BASE+VIA_ACR
        ; Poll IFR.SR up to 256 iterations; IFR.SR set = unexpected fail
        ldx #0
tsm1ni_loop:
        lda VIA_BASE+VIA_IFR
        and #IFR_SR
        bne tsm1ni_fail         ; IFR.SR set -> unexpected, fail
        inx
        bne tsm1ni_loop         ; not wrapped yet -> continue
        ; Timeout: expected outcome - IFR.SR was never set
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_OFF
        sta VIA_BASE+VIA_ACR
        cli
        lda #0
        rts
tsm1ni_fail:
        stx FAIL_IDX            ; save iteration number when IFR.SR was detected
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_OFF
        sta VIA_BASE+VIA_ACR
        cli
        lda #1
        rts

; ============================================================
; Subroutine: test_sr_mode5_cb1
;
; Tests SR mode 5 (shift out under T2 control) by bit-banging:
; for each of 8 output bits, polls CB1 low then CB1 high, samples
; CB2 at the rising CB1 edge, and accumulates the result byte.
; Verifies IFR.SR remains clear during shifting and is set after
; all 8 bits.  Verifies the reconstructed byte == SR_INIT.
;
; Hardware connections required:
;   CB1 -> Pin 6 -> Pin 5 -> PIA1 PA7 (input): reads VIA output clock
;   CB2 -> Pin M -> Pin L -> VIA PA7  (input, DDRA=$00): reads data
;   PIA1 PA7 must be an input before calling (VIA drives CB1 output).
;
; Caller sets SR_INIT, SR_T2_LO, SR_T2_HI before calling.
;
; CB2 is sampled at the rising CB1 edge (CB1 high after being low).
; The VIA shifts MSB first: bit 7 of SR_INIT appears on the first
; rising edge, bit 0 on the eighth.  ROL accumulates these MSB-first
; so after 8 iterations SR_M5_RESULT == SR_INIT.
;
; FAIL_IDX encoding on failure:
;   (bit_num << 4) | $0 : IFR.SR set early at this bit
;   (bit_num << 4) | $1 : CB1 did not go low within 256 polls
;   (bit_num << 4) | $2 : CB1 did not go high within 256 polls
;   $09               : IFR.SR not set after 8 bits
;   $0A               : reconstructed byte != SR_INIT
;
; Returns: A = 0 (pass), A = 1 (fail)
; Clobbers: A, X
; ============================================================
test_sr_mode5_cb1:
        sei
        ; Disable SR and clear SR register
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        sta VIA_BASE+VIA_ACR
        lda #0
        sta VIA_BASE+VIA_SR
        ; Set CB2 as input (PCR bits 7:5 = 000)
        lda VIA_BASE+VIA_PCR
        and #$1F
        sta VIA_BASE+VIA_PCR
        ; Set all VIA PA as inputs (DDRA = $00); PA7 reads CB2 via loopback
        lda #0
        sta VIA_BASE+VIA_DDRA
        ; Load T2 and start counting
        lda SR_T2_LO
        sta VIA_BASE+VIA_T2CL
        lda SR_T2_HI
        sta VIA_BASE+VIA_T2CH
        ; Set SR to mode 5: shift out under T2 control
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_OT2
        sta VIA_BASE+VIA_ACR
        ; Write SR_INIT to SR to arm the shift-out sequence
        lda SR_INIT
        sta VIA_BASE+VIA_SR
        ; Initialise result accumulator and bit counter
        lda #0
        sta SR_M5_RESULT
        lda #1
        sta SR_M5_BITNO
tsm5_bit_loop:
        ; -- Check IFR.SR is still clear --
        lda VIA_BASE+VIA_IFR
        and #IFR_SR
        beq tsm5_ifr_ok
        ; IFR.SR already set: FAIL_IDX = (bit_num << 4) | 0
        lda SR_M5_BITNO
        asl
        asl
        asl
        asl
        sta FAIL_IDX
        jmp tsm5_fail
tsm5_ifr_ok:
        ; -- Poll CB1 low (up to 256 iterations) --
        ldx #0
tsm5_wait_lo:
        lda PIA1_BASE+PIA_ORA
        and #$80
        beq tsm5_cb1_low        ; bit 7 = 0 -> CB1 low
        inx
        bne tsm5_wait_lo
        ; Timeout: FAIL_IDX = (bit_num << 4) | 1
        lda SR_M5_BITNO
        asl
        asl
        asl
        asl
        ora #$01
        sta FAIL_IDX
        jmp tsm5_fail
tsm5_cb1_low:
        ; -- Poll CB1 high (up to 256 iterations) --
        ldx #0
tsm5_wait_hi:
        lda PIA1_BASE+PIA_ORA
        and #$80
        bne tsm5_cb1_high       ; bit 7 = 1 -> CB1 high
        inx
        bne tsm5_wait_hi
        ; Timeout: FAIL_IDX = (bit_num << 4) | 2
        lda SR_M5_BITNO
        asl
        asl
        asl
        asl
        ora #$02
        sta FAIL_IDX
        jmp tsm5_fail
tsm5_cb1_high:
        ; -- Sample CB2 and shift into result --
        lda VIA_BASE+VIA_ORA_NH ; read VIA PA7 (CB2 via loopback)
        asl                     ; CB2 bit 7 -> carry
        rol SR_M5_RESULT        ; carry -> bit 0, previous bits shift left
        ; Advance bit counter; loop until 8 bits processed
        inc SR_M5_BITNO
        lda SR_M5_BITNO
        cmp #9
        bne tsm5_bit_loop
        ; -- Verify IFR.SR is set after 8 bits --
        lda VIA_BASE+VIA_IFR
        and #IFR_SR
        bne tsm5_check_val
        lda #$09
        sta FAIL_IDX
        jmp tsm5_fail
tsm5_check_val:
        ; -- Verify reconstructed byte == SR_INIT --
        lda SR_M5_RESULT
        cmp SR_INIT
        beq tsm5_pass
        lda #$0A
        sta FAIL_IDX
        ; fall through to tsm5_fail
tsm5_fail:
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_OFF
        sta VIA_BASE+VIA_ACR
        cli
        lda #1
        rts
tsm5_pass:
        lda VIA_BASE+VIA_ACR
        and #ACR_SR_NMASK
        ora #ACR_SR_OFF
        sta VIA_BASE+VIA_ACR
        cli
        lda #0
        rts


; Loads 256 bytes from a CBM PRG file on device 8 into REF_BUF,
; then compares REF_BUF byte-by-byte against MEAS_BUF.
;
; Entry: A = low byte of filename address
;        X = high byte of filename address
;        Y = filename length
; Returns: A = 0 (pass), A = 1 (fail: mismatch or file error)
; Clobbers: A, X, Y, FNPTR, FNLEN
; ============================================================
compare_file:
        sta FNPTR
        stx FNPTR+1
        sty FNLEN

        ; Save measurement ACR; restore VIA to KERNAL-safe state.
        sei
        lda VIA_BASE+VIA_ACR
        sta MEAS_ACR
        lda ACR_SAVE
        sta VIA_BASE+VIA_ACR
        lda #$ff
        sta VIA_BASE+VIA_T1LL
        sta VIA_BASE+VIA_T1LH   ; write latch high (clears IFR6; does not start timer)
        lda IER_SAVE
        ora #$80
        sta VIA_BASE+VIA_IER
        cli

        lda FNLEN
        ldx FNPTR
        ldy FNPTR+1
        jsr SETNAM

        ; LFN=1, device=8, SA=0 -> LOAD uses address embedded in PRG header ($7F00)
        lda #1
        ldx #8
        ldy #0
        jsr SETLFS

        ; load PRG file: A=0 (load); load address from PRG header -> REF_BUF
        lda #0
        jsr PET_LOAD
        bcs cf_file_err

        jsr cf_via_restore

        ; compare MEAS_BUF against REF_BUF
        ldx #0
cf_cmp_lp:
        lda MEAS_BUF,x
        cmp REF_BUF,x
        bne cf_mismatch
        inx
        bne cf_cmp_lp

        lda #0              ; pass
        rts

cf_mismatch:
        stx FAIL_IDX        ; save index of first mismatching byte
        lda #1              ; fail - mismatch
        rts

cf_file_err:
        jsr cf_via_restore
        lda #$ff
        sta FAIL_IDX        ; flag as file error (no valid byte index)
        lda #1              ; fail - file not found / load error
        rts

; ============================================================
; Subroutine: cf_via_restore
;
; Restores the VIA ACR to measurement state after PET_LOAD.
; ============================================================
cf_via_restore:
        sei
        lda MEAS_ACR
        sta VIA_BASE+VIA_ACR
        lda #IFR_T1|IFR_T2|IFR_SR  ; bit7=0: disable these IRQ sources
        sta VIA_BASE+VIA_IER
        cli
        rts

; ============================================================
; Subroutine: wait_key
;
; Prints "PRESS ANY KEY", blocks until a key is pressed, then
; clears the screen so the next section starts at the top.
; ============================================================
wait_key:
        lda #<msg_press_key
        ldx #>msg_press_key
        jsr print_str
wk_lp:  jsr GETIN
        beq wk_lp
        lda #$93
        jsr CHROUT
        rts

; ============================================================
; Subroutine: print_result
;
; Prints "OK" or "FAIL" and updates PASS_CNT / FAIL_CNT.
; Input: A = 0 -> pass, A != 0 -> fail
; ============================================================
print_result:
        cmp #0
        bne pr_fail
        inc PASS_CNT
        lda #<msg_ok
        ldx #>msg_ok
        jsr print_str
        rts
pr_fail:
        inc FAIL_CNT
        lda #<msg_fail
        ldx #>msg_fail
        jsr print_str
        lda FAIL_IDX        ; byte index from compare_file (or FAIL_STEP for mode 0)
        jsr print_hex
        lda #$0d
        jsr CHROUT
        rts

; ============================================================
; Subroutine: print_result_cnt
;
; Like print_result but on pass prints "OK @XX" where XX is the
; SR_IFR_COUNT value (iteration count) as two hex digits, then
; a newline.  Used by test_sr_mode1_ifr.
; Input: A = 0 -> pass, A != 0 -> fail
; ============================================================
print_result_cnt:
        cmp #0
        bne prc_fail
        inc PASS_CNT
        lda #<msg_ok_cnt
        ldx #>msg_ok_cnt
        jsr print_str
        lda SR_IFR_COUNT
        jsr print_hex
        lda #$0d
        jsr CHROUT
        rts
prc_fail:
        inc FAIL_CNT
        lda #<msg_fail
        ldx #>msg_fail
        jsr print_str
        lda FAIL_IDX
        jsr print_hex
        lda #$0d
        jsr CHROUT
        rts

; ============================================================
; Subroutine: print_hex
;
; Prints a byte as two uppercase hex digits via CHROUT.
; Entry: A = byte to print
; ============================================================
print_hex:
        pha
        lsr
        lsr
        lsr
        lsr
        jsr print_nybble
        pla
        and #$0f
        jsr print_nybble
        rts

print_nybble:
        cmp #10
        bcc ph_digit
        adc #6                      ; carry set: 'A'-'9'-1=7 -> 'A'..'F'
ph_digit:
        adc #'0'
        jsr CHROUT
        rts

; ============================================================
; Subroutine: print_str
;
; Prints a null-terminated string via CHROUT.
; Entry: A = low byte of address, X = high byte
; ============================================================
print_str:
        sta STRPTR
        stx STRPTR+1
ps_lp:
        ldy #0
        lda (STRPTR),y
        beq ps_done
        jsr CHROUT
        inc STRPTR
        bne ps_lp
        inc STRPTR+1
        jmp ps_lp
ps_done:
        rts

.include "pet_kernal.inc"   ; SETNAM, SETLFS, PET_SAVE, PET_LOAD, KERNAL ZP defs

; ============================================================
; Message strings (null-terminated, CBM uppercase charset)
; ============================================================
msg_banner:    .byte "VIA SR TEST MODULE", $0d
               .byte "------------------", $0d, 0

msg_grp1:      .byte "GRP1: SR MODE 0 (EXT CB1 CLOCK)", $0d, 0
msg_t1:        .byte "  1  SR MODE0 CB1/CB2 SEQ: ", 0

msg_grp2:      .byte "GRP2: SR MODE 1 (SHIFT IN VIA T2)", $0d, 0
msg_t2a:       .byte "  2A SR MODE1 T2=$0110: ", 0
msg_t2b:       .byte "  2B SR MODE1 T2=$0220: ", 0
msg_t2c:       .byte "  2C SR MODE1 T2=$0330: ", 0
msg_t2d:       .byte "  2D SR MODE1 T2=$0440: ", 0

msg_grp3:      .byte "GRP3: SR MODE 5 (SHIFT OUT VIA T2) SR=$55", $0d, 0
msg_t3a:       .byte "  3A SR MODE5 SR=$55 T2=$0110: ", 0
msg_t3b:       .byte "  3B SR MODE5 SR=$55 T2=$0220: ", 0
msg_t3c:       .byte "  3C SR MODE5 SR=$55 T2=$0330: ", 0
msg_t3d:       .byte "  3D SR MODE5 SR=$55 T2=$0440: ", 0

msg_grp4:      .byte "GRP4: SR MODE 1 NO ARM (SHIFT IN VIA T2)", $0d, 0
msg_t4a:       .byte "  4A SR M1NOARM T2=$0110: ", 0
msg_t4b:       .byte "  4B SR M1NOARM T2=$0220: ", 0
msg_t4c:       .byte "  4C SR M1NOARM T2=$0330: ", 0
msg_t4d:       .byte "  4D SR M1NOARM T2=$0440: ", 0

msg_grp5:      .byte "GRP5: SR MODE 5 (SHIFT OUT VIA T2) SR=$AA", $0d, 0
msg_t5a:       .byte "  5A SR MODE5 SR=$AA T2=$0110: ", 0
msg_t5b:       .byte "  5B SR MODE5 SR=$AA T2=$0220: ", 0
msg_t5c:       .byte "  5C SR MODE5 SR=$AA T2=$0330: ", 0
msg_t5d:       .byte "  5D SR MODE5 SR=$AA T2=$0440: ", 0

msg_grp6:      .byte "GRP6: SR MODE 3 (SHIFT IN EXT CB1)", $0d, 0
msg_t6a:       .byte "  6A SR MODE3 DATA=$55: ", 0
msg_t6b:       .byte "  6B SR MODE3 DATA=$AA: ", 0
msg_t6c:       .byte "  6C SR MODE3 DATA=$A5: ", 0
msg_t6d:       .byte "  6D SR MODE3 DATA=$5A: ", 0

msg_grp7:      .byte "GRP7: SR MODE 1 IFR POLL (VIA T2)", $0d, 0
msg_t7a:       .byte "  7A SR M1IFR T2=$0110: ", 0
msg_t7b:       .byte "  7B SR M1IFR T2=$0220: ", 0
msg_t7c:       .byte "  7C SR M1IFR T2=$0330: ", 0
msg_t7d:       .byte "  7D SR M1IFR T2=$0440: ", 0

msg_grp8:      .byte "GRP8: SR MODE 1 NO ARM IFR POLL (VIA T2)", $0d, 0
msg_t8a:       .byte "  8A SR M1NIFR T2=$0110: ", 0
msg_t8b:       .byte "  8B SR M1NIFR T2=$0220: ", 0
msg_t8c:       .byte "  8C SR M1NIFR T2=$0330: ", 0
msg_t8d:       .byte "  8D SR M1NIFR T2=$0440: ", 0

msg_grp9:      .byte "GRP9: SR MODE 5 CB1 POLL SR=$55 (VIA T2)", $0d, 0
msg_t9a:       .byte "  9A SR M5CB1 SR=$55 T2=$0110: ", 0
msg_t9b:       .byte "  9B SR M5CB1 SR=$55 T2=$0220: ", 0
msg_t9c:       .byte "  9C SR M5CB1 SR=$55 T2=$0330: ", 0
msg_t9d:       .byte "  9D SR M5CB1 SR=$55 T2=$0440: ", 0

msg_grp10:     .byte "GRP10: SR MODE 5 CB1 POLL SR=$AA (VIA T2)", $0d, 0
msg_t10a:      .byte "  10A SR M5CB1 SR=$AA T2=$0110: ", 0
msg_t10b:      .byte "  10B SR M5CB1 SR=$AA T2=$0220: ", 0
msg_t10c:      .byte "  10C SR M5CB1 SR=$AA T2=$0330: ", 0
msg_t10d:      .byte "  10D SR M5CB1 SR=$AA T2=$0440: ", 0

msg_ok:        .byte "OK", $0d, 0
msg_ok_cnt:    .byte "OK @", 0
msg_fail:      .byte "FAIL @", 0
msg_press_key: .byte "PRESS ANY KEY...", $0d, 0
msg_divider:   .byte "------------------", $0d, 0
msg_all_pass:  .byte "ALL TESTS PASSED", $0d, 0
msg_some_fail: .byte "SOME TESTS FAILED", $0d, 0

